---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
---

<MainLayout title="Pilih Games | Mimi Matematika">

    <Header />

    <main class="games-page">

        <section class="games-header">
            <div class="games-icon">🎮</div>

            <h1>Pilih Games</h1>

            <p>Yuk bermain bersama Mimi!</p>
        </section>

        <section class="games-grid">

            <a href="/permainan/tangkap-bintang" class="game-card">

                <div class="game-card-icon">⭐</div>

                <div class="game-card-content">
                    <h2>Tangkap Bintang</h2>
                    <p>Tangkap bintang sebanyak mungkin!</p>
                </div>

                <span class="game-arrow">→</span>

            </a>

            <a href="/permainan/perang-galaksi" class="game-card">

                <div class="game-card-icon">🚀</div>

                <div class="game-card-content">
                    <h2>Perang Galaksi</h2>
                    <p>Hindari komet dan kumpulkan Gem!</p>
                </div>

                <span class="game-arrow">→</span>

            </a>

            <!-- DOKTER GIGI MIMI -->
            <a href="/permainan/dokter-gigi-mimi" class="game-card">

                <div class="game-card-icon">🦷</div>

                <div class="game-card-content">
                    <h2>Dokter Gigi Mimi</h2>
                    <p>Bersihkan semua kuman di gigi!</p>
                </div>

                <span class="game-arrow">→</span>

            </a>

        </section>

        <footer class="site-footer">

            <div class="footer-inner">

                <div class="footer-brand">

                    <img
                        src="/assets/mimi.png"
                        alt="Mimi Matematika"
                    />

                    <div>
                        <strong>Mimi Matematika</strong>

                        <span>
                            Langkah kecil hari ini, prestasi besar nanti.
                        </span>
                    </div>

                </div>

                <div class="footer-links">

                    <a href="/belajar">Belajar</a>
                    <a href="/ngobrol">Mimi Ngobrol</a>
                    <a href="/permainan">Permainan</a>

                </div>

            </div>

            <div class="footer-bottom">
                © 2026 Mimi Matematika
            </div>

        </footer>

    </main>

</MainLayout>

<style>

.games-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 28px 24px 30px;
    background: #f3faf5;
}

.games-header {
    text-align: center;
    padding: 20px 0 24px;
}

.games-icon {
    font-size: 38px;
    margin-bottom: 6px;
}

.games-header h1 {
    margin: 0;
    color: #173f4b;
    font-size: 28px;
}

.games-header p {
    margin: 6px 0 0;
    color: #718078;
    font-size: 13px;
}

.games-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 30px;
}

.game-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 130px;
    padding: 20px;
    background: #fffdf9;
    border-radius: 22px;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 3px 12px rgba(70, 100, 80, 0.06);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.game-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(70, 100, 80, 0.10);
}

.game-card-icon {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #edf3ee;
    border-radius: 18px;
    font-size: 34px;
}

.game-card-content {
    flex: 1;
}

.game-card-content h2 {
    margin: 0 0 5px;
    color: #173f4b;
    font-size: 18px;
}

.game-card-content p {
    margin: 0;
    color: #718078;
    font-size: 12px;
    line-height: 1.5;
}

.game-arrow {
    color: #7faf8b;
    font-size: 22px;
    font-weight: 700;
}

.site-footer {
    width: 100%;
    background: #e8f6ec;
}

.site-footer .footer-inner {
    width: 100%;
    min-height: 64px;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.site-footer .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
}

.site-footer .footer-brand img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

.site-footer .footer-brand > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.site-footer .footer-brand strong {
    font-size: 13px;
    line-height: 1.1;
}

.site-footer .footer-brand span {
    font-size: 10px;
    line-height: 1.2;
}

.site-footer .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
}

.site-footer .footer-links a {
    font-size: 11px;
}

.site-footer .footer-bottom {
    padding: 7px 24px 9px;
    font-size: 9px;
}

@media (max-width: 600px) {

    .games-page {
        padding: 20px 14px 24px;
    }

    .games-header {
        padding: 12px 0 18px;
    }

    .games-icon {
        font-size: 32px;
    }

    .games-header h1 {
        font-size: 23px;
    }

    .games-grid {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .game-card {
        min-height: 105px;
        padding: 15px;
        border-radius: 18px;
        gap: 12px;
    }

    .game-card-icon {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        font-size: 28px;
    }

    .game-card-content h2 {
        font-size: 16px;
    }

    .game-card-content p {
        font-size: 11px;
    }

    .site-footer .footer-inner {
        padding: 12px 14px;
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .site-footer .footer-links {
        gap: 14px;
    }

}

</style>
