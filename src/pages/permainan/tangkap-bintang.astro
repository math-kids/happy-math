---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
---

<MainLayout title="Tangkap Bintang — Mimi Matematika">
    <Header />

    <main class="game-page">
        <div class="game-body">
            <div class="game-topbar">
                <a href="/belajar/kelas-2"> ← Kembali ke latihan </a>

                <span>🎁 Game Hadiah</span>

                <span></span>
            </div>

            <section class="game-content">
                <div class="game-icon">🌟</div>

                <h1>Tangkap Bintang</h1>

                <p class="game-intro">Tangkap bintang sebanyak mungkin!</p>

                <div class="game-status">
                    <div>
                        ⭐
                        <strong id="star-score">0</strong>
                    </div>

                    <div>
                        ⏱️
                        <strong id="star-time">20</strong>
                    </div>
                </div>

                <div id="star-arena" class="star-arena">
                    <button
                        id="star-target"
                        type="button"
                        aria-label="Tangkap bintang"
                    >
                        ⭐
                    </button>
                </div>

                <p class="game-hint">Klik bintangnya sebanyak mungkin! 🌟</p>
            </section>
        </div>

        <!-- FOOTER -->

        <footer class="site-footer">
            <div class="footer-inner">
                <div class="footer-brand">
                    <img src="/assets/mimi.png" alt="Mimi Matematika" />

                    <div>
                        <strong>Mimi Matematika</strong>

                        <span>
                            Langkah kecil hari ini, prestasi besar nanti.
                        </span>
                    </div>
                </div>

                <div class="footer-links">
                    <a href="/belajar">Belajar</a>
                    <a href="/ngobrol">Mimi Ngobrol</a>
                    <a href="/permainan">Permainan</a>
                </div>
            </div>

            <div class="footer-bottom">© 2026 Mimi Matematika</div>
        </footer>
    </main>
</MainLayout>

<style>
    .game-page {
        width: 100%;
        max-width: 1180px;
        min-height: calc(100vh - 80px);
        margin: 0 auto;
        padding: 8px 24px 0;

        background: #f3faf5;

        display: flex;
        flex-direction: column;
    }

 .game-body {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.game-content {
    flex: 1;
    width: 100%;
    max-width: none;
    text-align: center;

    display: flex;
    flex-direction: column;
    align-items: center;
}

.star-arena {
    position: relative;

    width: 100%;
    max-width: none;

    flex: 1;
    min-height: 320px;

    margin: 14px 0 8px;

    border-radius: 24px;
    overflow: hidden;

    background: #f4ead9;
    border: 4px solid #d9b58d;
}

    .game-topbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        margin-bottom: 10px;
        font-size: 12px;
    }

    .game-topbar a {
        color: #39704b;
        text-decoration: none;
        font-weight: 600;
    }

    .game-topbar span {
        color: #718078;
        font-weight: 600;
    }

    .game-content {
        text-align: center;
        max-width: 800px;
        margin: 0 auto;
    }

    .game-icon {
        font-size: 42px;
        line-height: 1;
        margin: 8px 0;
    }

    .game-content h1 {
        margin: 0;
        color: #173f4b;
        font-size: 28px;
    }

    .game-intro {
        margin: 5px 0 12px;
        color: #718078;
        font-size: 13px;
    }

    .game-status {
        display: flex;
        justify-content: center;
        gap: 35px;
        margin: 10px 0;
        color: #526258;
        font-size: 18px;
    }

    .game-status strong {
        margin-left: 4px;
        color: #39704b;
    }

    .star-arena {
        position: relative;
        width: 100%;
        max-width: 700px;
        height: 400px;
        margin: 14px auto;
        border-radius: 24px;
        overflow: hidden;
        background: #f4ead9;
        border: 4px solid #d9b58d;
    }

    #star-target {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);

        width: 80px;
        height: 80px;

        border: none;
        background: transparent;

        font-size: 58px;
        line-height: 1;

        cursor: pointer;
        padding: 0;

        transition: transform 0.1s ease;
    }

    #star-target:hover {
        transform: scale(1.12);
    }

    #star-target:active {
        transform: scale(0.92);
    }

    .game-hint {
        margin: 8px 0;
        color: #718078;
        font-size: 12px;
    }

    .site-footer {
        width: 100%;
        margin-top: auto;
        background: #e8f6ec;
    }

    .site-footer .footer-inner {
        width: 100%;
        min-height: 64px;
        padding: 12px 24px;

        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .site-footer .footer-brand {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .site-footer .footer-brand img {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .site-footer .footer-brand > div {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 2px;
    }

    .site-footer .footer-brand strong {
        font-size: 13px;
        line-height: 1.1;
    }

    .site-footer .footer-brand span {
        font-size: 10px;
        line-height: 1.2;
    }

    .site-footer .footer-links {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .site-footer .footer-links a {
        color: #39704b;
        font-size: 11px;
        text-decoration: none;
    }

    .site-footer .footer-bottom {
        padding: 7px 24px 9px;
        font-size: 9px;
        color: #718078;
    }

    /* ========================================
   MOBILE
======================================== */

    @media (max-width: 600px) {
        .game-page {
            padding: 8px 14px 20px;
            min-height: calc(100vh - 70px);
        }

        .game-topbar {
            margin-bottom: 6px;
            font-size: 10px;
        }

        .game-icon {
            font-size: 34px;
            margin: 5px 0;
        }

        .game-content h1 {
            font-size: 23px;
        }

        .game-intro {
            margin: 4px 0 8px;
            font-size: 12px;
        }

        .game-status {
            gap: 25px;
            margin: 7px 0;
            font-size: 16px;
        }

        .star-arena {
    width: 100%;
    min-height: 0;
    height: auto;

    flex: 1;

    margin: 10px 0 8px;

    border-radius: 18px;
    border-width: 3px;
}

        #star-target {
            width: 70px;
            height: 70px;
            font-size: 50px;
        }

        .game-hint {
            font-size: 11px;
        }
        @media (max-width: 600px) {
            .game-page {
                min-height: calc(100vh - 70px);
                padding: 8px 14px 0;
            }

            .game-body {
                flex: 1;
            }

            .site-footer .footer-inner {
                min-height: auto;
                padding: 10px 14px;

                display: flex;
                flex-direction: row;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
            }

            .site-footer .footer-brand {
                gap: 5px;
            }

            .site-footer .footer-brand img {
                width: 28px;
                height: 28px;
            }

            .site-footer .footer-brand > div {
                align-items: flex-start;
                text-align: left;
                gap: 1px;
            }

            .site-footer .footer-brand strong {
                font-size: 11px;
            }

            .site-footer .footer-brand span {
                font-size: 8px;
            }

            .site-footer .footer-links {
                gap: 10px;
            }

            .site-footer .footer-links a {
                font-size: 9px;
            }

            .site-footer .footer-bottom {
                padding: 6px 14px 8px;
                font-size: 8px;
            }
        }
    }
    /* ========================================
   GAME ARENA - FULL WIDTH
======================================== */

.game-content {
    width: 100%;
    max-width: none !important;
}

.star-arena {
    width: 100% !important;
    max-width: none !important;
    box-sizing: border-box;

    height: 420px;
    margin: 14px 0 8px !important;
}
</style>

<script>
    const starTarget = document.getElementById(
        "star-target",
    ) as HTMLButtonElement;

    const starArena = document.getElementById("star-arena") as HTMLDivElement;

    const starScoreElement = document.getElementById(
        "star-score",
    ) as HTMLElement;

    const starTimeElement = document.getElementById("star-time") as HTMLElement;

    let starScore = 0;
    let timeLeft = 20;
    let gameRunning = true;

    /* ========================================
   PINDAHKAN BINTANG
======================================== */

    function moveStar() {
        const maxX = starArena.clientWidth - 80;

        const maxY = starArena.clientHeight - 80;

        const x = Math.random() * maxX;

        const y = Math.random() * maxY;

        starTarget.style.left = `${x}px`;

        starTarget.style.top = `${y}px`;

        starTarget.style.transform = "none";
    }

    /* ========================================
   KLIK BINTANG
======================================== */

    starTarget.addEventListener("click", function () {
        if (!gameRunning) {
            return;
        }

        starScore++;

        starScoreElement.textContent = String(starScore);

        moveStar();
    });

    /* ========================================
   TIMER
======================================== */

    const gameTimer = setInterval(function () {
        if (!gameRunning) {
            clearInterval(gameTimer);
            return;
        }

        timeLeft--;

        starTimeElement.textContent = String(timeLeft);

        if (timeLeft <= 0) {
            gameRunning = false;

            clearInterval(gameTimer);

            starTarget.disabled = true;

            showResult();
        }
    }, 1000);

    /* ========================================
   HASIL
======================================== */
    function showResult() {
        const gameContent = document.querySelector(".game-content");

        if (!gameContent) {
            return;
        }

        gameContent.innerHTML = `

        <div class="game-icon">
            🎉
        </div>

        <h1>Hebat!</h1>

        <p class="game-intro">
            Kamu berhasil menangkap
            <strong>${starScore}</strong>
            bintang!
        </p>

        <div class="game-result-score">
            ⭐ ${starScore}
        </div>

        <div class="result-actions">

        <a
            href="/belajar/kelas-2"
            class="back-to-lessons"
        >
            ← Kembali ke Latihan
        </a>

        </div>

    `;
    }
</script>
