---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
---

<MainLayout title="Mimi Ngobrol">
    <Header />

    <main class="ngobrol-page">
        <section class="ngobrol-heading">
            <div class="ngobrol-title">
                <span class="ngobrol-badge">💬 Mimi Ngobrol</span>
                <h1>Yuk ngobrol bareng Mimi!</h1>
                <p>Tanya apa saja yang ingin kamu ketahui.</p>
            </div>
        </section>

        <section class="chat-container">
            <div class="chat-card">
                <div id="chat-messages" class="chat-messages">
                    <div class="chat-row mimi-row">
                        <img
                            src="/assets/mimi.png"
                            alt="Mimi"
                            class="chat-mimi"
                        />
                        <div class="message-content">
                            <span class="message-name">Mimi</span>
                            <div class="message-bubble mimi-bubble">
                                Halo! 👋<br />
                                Aku Mimi. 😊<br />
                                <strong>Ketik pertanyaanmu, yuk!</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="chat-input-area">
                    <button
                        type="button"
                        class="image-button"
                        id="image-button"
                        aria-label="Kirim gambar"
                        title="Kirim gambar"
                    >
                        🖼️
                    </button>

                    <input
                        type="file"
                        id="image-input"
                        accept="image/jpeg,image/png,image/webp,image/gif"
                        hidden
                    />

                    <div id="image-preview" class="image-preview" hidden>
                        <img id="image-preview-img" alt="Preview gambar" />
                        <button
                            type="button"
                            id="remove-image"
                            class="remove-image"
                            aria-label="Hapus gambar"
                            title="Hapus gambar">×</button
                        >
                    </div>

                    <input
                        type="text"
                        id="chat-input"
                        placeholder="Ketik pertanyaanmu..."
                        autocomplete="off"
                        aria-label="Ketik pertanyaan"
                    />

                    <button id="send-button" type="button">Kirim</button>
                    
                </div>
                <p class="ai-disclaimer">
                        Mimi adalah AI, Mimi bisa salah.
                    </p>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <img src="/assets/mimi.png" alt="Mimi Matematika" />
                <div>
                    <strong>Mimi Matematika</strong>
                    <span>Langkah kecil hari ini, prestasi besar nanti.</span>
                </div>
            </div>
            <div class="footer-links">
                <a href="/belajar">Belajar</a>
                <a href="/ngobrol">Mimi Ngobrol</a>
                <a href="/permainan">Permainan</a>
            </div>
        </div>
        <div class="footer-bottom">© 2026 Mimi Matematika</div>
    </footer>
</MainLayout>

<style>
    .ngobrol-page {
        width: 100%;
        max-width: 1180px;
        min-height: 560px;
        margin: 0 auto;
        padding: 28px 24px 40px;
        box-sizing: border-box;
        background: #f3faf5;
    }

    .ngobrol-heading {
        width: 100%;
        max-width: 820px;
        margin: 0 auto 24px;
        text-align: center;
    }

    .ngobrol-title {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .ngobrol-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        border-radius: 999px;
        background: #e1f0e6;
        color: #48745a;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 9px;
    }

    .ngobrol-title h1 {
        margin: 0;
        color: #173f4b;
        font-size: 28px;
        line-height: 1.2;
    }

    .ngobrol-title p {
        margin: 7px 0 0;
        color: #6d8589;
        font-size: 14px;
    }

    .chat-container {
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
    }

    .chat-card {
        width: 100%;
        min-height: 430px;
        padding: 28px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: #ffffff;
        border: 1px solid #dcebe1;
        border-radius: 24px;
        box-shadow: 0 8px 24px rgba(52, 91, 67, 0.07);
    }

    .chat-messages {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 18px;
        overflow-y: auto;
        padding-right: 4px;
        margin-bottom: 24px;
        scroll-behavior: smooth;
    }

    .chat-row {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        width: 100%;
    }

    :global(.mimi-row) {
        justify-content: flex-start;
    }

    .chat-mimi {
        width: 52px !important;
        height: 52px !important;
        max-width: 52px !important;
        max-height: 52px !important;
        flex: 0 0 52px;
        object-fit: contain;
    }

    .message-content {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 72%;
    }

    .message-name {
        margin: 2px 0 5px 4px;
        color: #537266;
        font-size: 12px;
        font-weight: 700;
    }

    .message-bubble {
        padding: 13px 17px;
        border-radius: 18px;
        font-size: 14px;
        line-height: 1.55;
        word-break: break-word;
        white-space: pre-wrap;
    }

    :global(.mimi-bubble) {
        padding: 13px 17px;
        border-radius: 18px 18px 18px 5px;
        background: #eaf6ee;
        color: #31534a;
        font-size: 14px;
        line-height: 1.55;
        word-break: break-word;
        white-space: pre-wrap;
    }

    :global(.mimi-bubble strong) {
        color: #2d6650;
    }

    :global(.mimi-row) {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        width: 100%;
    }

    :global(.mimi-row .message-content) {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        max-width: 72%;
    }

    :global(.mimi-row .message-name) {
        margin: 2px 0 5px 4px;
    }

    :global(.user-row) {
        display: flex;
        justify-content: flex-end;
        align-items: flex-start;
        width: 100%;
        gap: 10px;
    }

    :global(.user-row .message-content) {
        order: 1;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        max-width: 72%;
    }

    :global(.user-row .message-name) {
        margin: 2px 4px 5px 0;
    }

    :global(.chat-user-avatar) {
        order: 2;
        display: block !important;
        width: 52px !important;
        height: 52px !important;
        min-width: 52px !important;
        min-height: 52px !important;
        max-width: 52px !important;
        max-height: 52px !important;
        flex: 0 0 52px !important;
        object-fit: contain !important;
    }

    :global(.user-bubble) {
        padding: 13px 17px;
        border-radius: 18px 18px 5px 18px;
        background: #dcecf8;
        color: #315269;
        font-size: 14px;
        line-height: 1.55;
        word-break: break-word;
        white-space: pre-wrap;
    }

    :global(.user-question-image) {
        display: block;
        width: min(220px, 100%);
        max-height: 220px;
        object-fit: contain;
        border-radius: 12px;
        margin-bottom: 7px;
    }

    .thinking-bubble {
        color: #66827a;
        font-style: italic;
    }

    .chat-input-area {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
    }

    .image-button {
        width: 42px;
        height: 48px;
        flex: 0 0 42px;
        border: 0;
        border-radius: 14px;
        background: transparent;
        font-size: 20px;
        cursor: pointer;
        transition:
            background 0.15s ease,
            transform 0.15s ease;
    }

    .image-button:hover {
        background: #edf9f1;
        transform: translateY(-1px);
    }

    .image-preview {
        position: relative;
        flex: 0 0 52px;
        width: 52px;
        height: 52px;
    }

    .image-preview img {
        width: 52px;
        height: 52px;
        display: block;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #d9e8df;
    }

    .remove-image {
        position: absolute;
        top: -7px;
        right: -7px;
        width: 21px;
        height: 21px;
        border: 0;
        border-radius: 50%;
        background: #6e9f80;
        color: white;
        font-size: 15px;
        line-height: 21px;
        padding: 0;
        cursor: pointer;
    }

    #chat-input {
        flex: 1;
        min-width: 0;
        height: 48px;
        padding: 0 16px;
        box-sizing: border-box;
        border: 2px solid #dcebe1;
        border-radius: 14px;
        outline: none;
        background: #fbfdfb;
        color: #27474d;
        font-family: inherit;
        font-size: 14px;
    }

    #chat-input:focus {
        border-color: #9fc9ad;
        background: #ffffff;
    }

    #chat-input::placeholder {
        color: #9aaead;
    }

    #send-button {
        height: 48px;
        padding: 0 22px;
        border: none;
        border-radius: 14px;
        background: #79aa88;
        color: #ffffff;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        transition:
            transform 0.15s ease,
            background 0.15s ease;
    }

    #send-button:hover {
        background: #679976;
        transform: translateY(-1px);
    }

    #send-button:active {
        transform: translateY(0);
    }

    #send-button:disabled {
        opacity: 0.7;
        cursor: wait;
        transform: none;
    }

    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background: #dcebe1;
        border-radius: 10px;
    }

    .site-footer {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        background: #e8f6ec;
    }

    .site-footer .footer-inner {
        width: 100%;
        min-height: 64px;
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-sizing: border-box;
    }

    .site-footer .footer-brand {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .site-footer .footer-brand img {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .site-footer .footer-brand > div {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .site-footer .footer-brand strong {
        font-size: 13px;
        line-height: 1.1;
    }

    .site-footer .footer-brand span {
        font-size: 10px;
        line-height: 1.2;
    }

    .site-footer .footer-links {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .site-footer .footer-links a {
        font-size: 11px;
    }

    .site-footer .footer-bottom {
        padding: 7px 24px 9px;
        font-size: 9px;
        box-sizing: border-box;
    }
    
    .ai-disclaimer {
    margin: 5px 0 10px;
    text-align: center;
    color: #8a9a92;
    font-size: 10px;
    line-height: 1.3;
    }

    @media (max-width: 600px) {
         .ai-disclaimer {
        margin: 4px 0 8px;
        font-size: 9px;
    }
        .ngobrol-page {
            min-height: 520px;
            padding: 20px 14px 28px;
        }

        .ngobrol-heading {
            margin-bottom: 18px;
        }

        .ngobrol-badge {
            font-size: 11px;
            padding: 5px 10px;
        }

        .ngobrol-title h1 {
            font-size: 22px;
        }

        .ngobrol-title p {
            font-size: 12px;
        }

        .chat-card {
            min-height: 430px;
            padding: 18px 14px;
            border-radius: 20px;
        }

        .chat-messages {
            gap: 14px;
            margin-bottom: 18px;
        }

        .chat-mimi {
            width: 44px !important;
            height: 44px !important;
            max-width: 44px !important;
            max-height: 44px !important;
            flex: 0 0 44px;
        }

        :global(.chat-user-avatar) {
            width: 44px !important;
            height: 44px !important;
            max-width: 44px !important;
            max-height: 44px !important;
            min-width: 44px !important;
            min-height: 44px !important;
            flex: 0 0 44px !important;
        }

        .message-content,
        :global(.user-row .message-content),
        :global(.mimi-row .message-content) {
            max-width: 78%;
        }

        .message-name {
            font-size: 11px;
        }

        .message-bubble,
        :global(.mimi-bubble),
        :global(.user-bubble) {
            padding: 11px 13px;
            font-size: 13px;
        }

        :global(.user-question-image) {
            max-width: 180px;
            max-height: 180px;
        }

        .chat-input-area {
            gap: 7px;
        }

        .image-button {
            width: 38px;
            height: 44px;
            flex: 0 0 38px;
            font-size: 18px;
        }

        .image-preview {
            width: 44px;
            height: 44px;
            flex-basis: 44px;
        }

        .image-preview img {
            width: 44px;
            height: 44px;
        }

        #chat-input,
        #send-button {
            height: 44px;
        }

        #chat-input {
            padding: 0 12px;
            font-size: 13px;
        }

        #send-button {
            padding: 0 15px;
            font-size: 13px;
        }

        .site-footer .footer-inner {
            padding: 12px 14px;
        }

        .site-footer .footer-links {
            gap: 10px;
        }

        .site-footer .footer-links a {
            font-size: 10px;
        }
    }

</style>

<script>
    type ChatImage = {
        mimeType: string;
        data: string;
        previewUrl: string;
    };

    type ChatMessage = {
        role: "user" | "assistant";
        content: string;
        image?: {
            mimeType: string;
            data: string;
        };
    };

    const input = document.getElementById(
        "chat-input",
    ) as HTMLInputElement | null;
    const sendButton = document.getElementById(
        "send-button",
    ) as HTMLButtonElement | null;
    const chatMessages = document.getElementById(
        "chat-messages",
    ) as HTMLDivElement | null;
    const imageButton = document.getElementById(
        "image-button",
    ) as HTMLButtonElement | null;
    const imageInput = document.getElementById(
        "image-input",
    ) as HTMLInputElement | null;
    const imagePreview = document.getElementById(
        "image-preview",
    ) as HTMLDivElement | null;
    const imagePreviewImg = document.getElementById(
        "image-preview-img",
    ) as HTMLImageElement | null;
    const removeImageButton = document.getElementById(
        "remove-image",
    ) as HTMLButtonElement | null;

    const messages: ChatMessage[] = [];
    let selectedImage: ChatImage | null = null;

    function escapeHtml(value: string) {
        return value
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function cleanMathFormatting(value: string) {
        return value
            .replace(/\$\$([^$]+)\$\$/g, "$1")
            .replace(/\$([^$]+)\$/g, "$1");
    }

    function addMessage(
        role: "user" | "assistant",
        text: string,
        image?: ChatImage | null,
    ) {
        if (!chatMessages) return;

        const row = document.createElement("div");
        row.className =
            role === "user" ? "chat-row user-row" : "chat-row mimi-row";

        if (role === "assistant") {
            const mimi = document.createElement("img");
            mimi.src = "/assets/mimi.png";
            mimi.alt = "Mimi";
            mimi.className = "chat-mimi";
            row.appendChild(mimi);
        }

        const content = document.createElement("div");
        content.className = "message-content";

        const name = document.createElement("span");
        name.className = "message-name";
        name.textContent = role === "user" ? "Kamu" : "Mimi";

        const bubble = document.createElement("div");
        bubble.className =
            role === "user"
                ? "message-bubble user-bubble"
                : "message-bubble mimi-bubble";

        if (role === "user" && image) {
            const imageElement = document.createElement("img");
            imageElement.src = image.previewUrl;
            imageElement.alt = "Gambar yang dikirim";
            imageElement.className = "user-question-image";
            bubble.appendChild(imageElement);
        }

        if (text) {
            const textElement = document.createElement("div");
            textElement.textContent =
                role === "assistant" ? cleanMathFormatting(text) : text;
            bubble.appendChild(textElement);
        }

        content.appendChild(name);
        content.appendChild(bubble);
        row.appendChild(content);

        if (role === "user") {
            const userAvatar = document.createElement("img");
            userAvatar.src = "/assets/aidan.png";
            userAvatar.alt = "Kamu";
            userAvatar.className = "chat-user-avatar";
            row.appendChild(userAvatar);
        }

        chatMessages.appendChild(row);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function addThinking() {
        if (!chatMessages) return;

        const row = document.createElement("div");
        row.className = "chat-row mimi-row";
        row.id = "thinking-message";

        const mimi = document.createElement("img");
        mimi.src = "/assets/mimi.png";
        mimi.alt = "Mimi";
        mimi.className = "chat-mimi";

        const content = document.createElement("div");
        content.className = "message-content";

        const name = document.createElement("span");
        name.className = "message-name";
        name.textContent = "Mimi";

        const bubble = document.createElement("div");
        bubble.className = "message-bubble mimi-bubble thinking-bubble";
        bubble.textContent = "Mimi sedang berpikir... 💭";

        content.appendChild(name);
        content.appendChild(bubble);
        row.appendChild(mimi);
        row.appendChild(content);
        chatMessages.appendChild(row);
        chatMessages.scrollTop = chatMessages.scrollHeight;
    }

    function removeThinking() {
        document.getElementById("thinking-message")?.remove();
    }

    function clearSelectedImage() {
        selectedImage = null;
        if (imagePreview) imagePreview.hidden = true;
        if (imagePreviewImg) imagePreviewImg.removeAttribute("src");
        if (imageInput) imageInput.value = "";
    }

    function handleImageFile(file: File) {
        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/gif",
        ];

        if (!allowedTypes.includes(file.type)) {
            alert("Mimi hanya bisa menerima JPG, PNG, WEBP, atau GIF ya 😊");
            return;
        }

        if (file.size > 5 * 1024 * 1024) {
            alert("Ukuran gambar maksimal 5 MB ya 😊");
            return;
        }

        const reader = new FileReader();
        reader.onload = () => {
            const result = reader.result;
            if (typeof result !== "string") return;

            const commaIndex = result.indexOf(",");
            if (commaIndex === -1) return;

            selectedImage = {
                mimeType: file.type,
                data: result.slice(commaIndex + 1),
                previewUrl: result,
            };

            if (imagePreviewImg) imagePreviewImg.src = result;
            if (imagePreview) imagePreview.hidden = false;
            input?.focus();
        };

        reader.readAsDataURL(file);
    }

    async function sendMessage() {
        if (!input || !sendButton) return;

        const text = input.value.trim();
        if (!text && !selectedImage) {
            input.focus();
            return;
        }

        const imageForMessage = selectedImage;

        addMessage("user", text, imageForMessage);

        messages.push({
            role: "user",
            content: text || "Tolong lihat gambar ini dan bantu aku ya.",
            ...(imageForMessage
                ? {
                      image: {
                          mimeType: imageForMessage.mimeType,
                          data: imageForMessage.data,
                      },
                  }
                : {}),
        });

        input.value = "";
        clearSelectedImage();
        sendButton.disabled = true;
        sendButton.textContent = "Mengirim...";
        addThinking();

        try {
            const response = await fetch("/api/chat", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                },
                body: JSON.stringify({ messages }),
            });

            const data = await response.json();

            removeThinking();

            if (!response.ok) {
                throw new Error(data.error || "Mimi belum bisa menjawab.");
            }

            const reply =
                data.reply || "Maaf, Mimi belum bisa menjawab sekarang. 😊";
            addMessage("assistant", reply);

            messages.push({
                role: "assistant",
                content: reply,
            });
        } catch (error) {
            console.error("Mimi chat error:", error);
            removeThinking();
            addMessage(
                "assistant",
                "Maaf ya, Mimi sedang mengalami masalah. Coba lagi sebentar ya! 😊",
            );
        } finally {
            sendButton.disabled = false;
            sendButton.textContent = "Kirim";
            input.focus();
        }
    }

    imageButton?.addEventListener("click", () => {
        imageInput?.click();
    });

    imageInput?.addEventListener("change", () => {
        const file = imageInput.files?.[0];
        if (file) handleImageFile(file);
    });

    removeImageButton?.addEventListener("click", clearSelectedImage);
    sendButton?.addEventListener("click", sendMessage);

    input?.addEventListener("keydown", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
            event.preventDefault();
            sendMessage();
        }
    });
</script>
