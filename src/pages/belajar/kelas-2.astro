---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
---

<MainLayout title="Kelas 2 SD — Mimi Matematika">
    <Header />

    <section class="class-hero">
        <img
            src="/assets/banner-kelas2.png"
            alt="Belajar Bareng Mimi - Kelas 2 SD"
        />
    </section>

    <main class="lesson-page">
        <!-- HEADER KELAS -->

        <!-- MATERI -->
        <section class="lesson-section">
            <div class="lesson-section-heading">
                <div>
                    <h2>📚 Materi Kelas 2</h2>
                    <p>Yuk belajar sedikit demi sedikit!</p>
                </div>
            </div>

            <div class="lesson-grid">
                <!-- 01 -->
                <a
                    href="/belajar/kelas-2/menghitung-benda"
                    class="lesson-card lesson-green"
                >
                    <div class="lesson-card-icon">🌿</div>

                    <div class="lesson-card-content">
                        <span class="lesson-number">01</span>

                        <h3>Menghitung Benda di Alam</h3>

                        <p>Hitung jumlah benda yang ada di gambar.</p>
                    </div>

                    <span class="lesson-arrow">→</span>
                </a>

                <!-- 02 -->
                <a
                    href="/belajar/kelas-2/menghitung-maju-mundur"
                    class="lesson-card lesson-blue"
                >
                    <div class="lesson-card-icon">⇄</div>

                    <div class="lesson-card-content">
                        <span class="lesson-number">02</span>

                        <h3>Menghitung Maju dan Mundur</h3>

                        <p>Menghitung bilangan secara berurutan.</p>
                    </div>

                    <span class="lesson-arrow">→</span>
                </a>

                <!-- 03 -->
                <a
                    href="/belajar/kelas-2/nilai-tempat"
                    class="lesson-card lesson-yellow"
                >
                    <div class="lesson-card-icon">🔢</div>

                    <div class="lesson-card-content">
                        <span class="lesson-number">03</span>

                        <h3>Nilai Tempat</h3>

                        <p>Mengenal nilai puluhan dan satuan.</p>

                        <span class="lesson-meta">3 bagian</span>
                    </div>

                    <span class="lesson-arrow">→</span>
                </a>

                <!-- 04 -->
                <a
                    href="/belajar/kelas-2/penjumlahan-satuan"
                    class="lesson-card lesson-orange"
                >
                    <div class="lesson-card-icon">🧮</div>

                    <div class="lesson-card-content">
                        <span class="lesson-number">04</span>

                        <h3>Penjumlahan Satuan</h3>

                        <p>Menjumlahkan bilangan satuan.</p>

                        <span class="lesson-meta">3 bagian</span>
                    </div>

                    <span class="lesson-arrow">→</span>
                </a>

                <!-- 05 -->
                <a
                    href="/belajar/kelas-2/penjumlahan-puluhan"
                    class="lesson-card lesson-purple"
                >
                    <div class="lesson-card-icon">➕</div>

                    <div class="lesson-card-content">
                        <span class="lesson-number">05</span>

                        <h3>Penjumlahan Puluhan</h3>

                        <p>Menjumlahkan bilangan puluhan.</p>
                    </div>

                    <span class="lesson-arrow">→</span>
                </a>

                <!-- 06 -->
                <a
                    href="/belajar/kelas-2/penjumlahan-bersusun"
                    class="lesson-card lesson-pink"
                >
                    <div class="lesson-card-icon">🧱</div>

                    <div class="lesson-card-content">
                        <span class="lesson-number">06</span>

                        <h3>Penjumlahan Bersusun</h3>

                        <p>Menjumlahkan bilangan secara bersusun.</p>

                        <span class="lesson-meta">3 bagian</span>
                    </div>

                    <span class="lesson-arrow">→</span>
                </a>

                <!-- 07 -->
                <a
                    href="/belajar/kelas-2/pengurangan-puluhan"
                    class="lesson-card lesson-green"
                >
                    <div class="lesson-card-icon">➖</div>

                    <div class="lesson-card-content">
                        <span class="lesson-number">07</span>

                        <h3>Pengurangan Puluhan</h3>

                        <p>Mengurangkan bilangan puluhan.</p>
                    </div>

                    <span class="lesson-arrow">→</span>
                </a>
            </div>
        </section>
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <img src="/assets/mimi.png" alt="Mimi Matematika" />

                <div>
                    <strong>Mimi Matematika</strong>
                    <span>Langkah kecil hari ini, prestasi besar nanti.</span>
                </div>
            </div>

            <div class="footer-links">
                <a href="/">Beranda</a>
                <a href="/belajar">Belajar</a>
                <a href="/permainan">Permainan</a>
            </div>
        </div>

        <div class="footer-bottom">© 2026 Mimi Matematika</div>
    </footer>
</MainLayout>
