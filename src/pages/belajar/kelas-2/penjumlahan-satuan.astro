---
import MainLayout from "../../../layouts/MainLayout.astro";
import Header from "../../../components/Header.astro";
---

<MainLayout title="Penjumlahan Satuan - Mimi Matematika">
    <Header />

    <main class="game-page">

        <div class="game-topbar">
            <a href="/belajar/kelas-2" class="back-link">← Kembali</a>
            <span class="game-number">Kelas 2 SD</span>
            <div></div>
        </div>

        <section class="exercise-banner">
            <img src="/assets/banner-latihan.png" alt="Mimi Matematika" />
        </section>

        <section class="exercise-info">
            <div>
                <span class="lesson-badge">Latihan 04</span>
                <h1>Penjumlahan Satuan</h1>
                <p>Yuk belajar menjumlahkan bilangan.</p>
            </div>

            <div class="progress" id="progress">
                Soal 1 dari 10
            </div>
        </section>

        <section class="mode-selector">

            <button id="basic-mode" class="mode-button active" type="button">
                🔢 Dasar
            </button>

            <button id="to10-mode" class="mode-button" type="button">
                🔟 Sampai 10
            </button>

            <button id="to18-mode" class="mode-button" type="button">
                🔢 Sampai 18
            </button>

            <button id="challenge-mode" class="mode-button" type="button">
                🧠 Tantangan
            </button>

        </section>

        <section id="mimi-area">

            <img id="mimi-image" src="/assets/mimi.png" alt="Mimi" />

            <div class="mimi-message" id="mimi-message">
                Yuk, hitung bersama Mimi! 😊
            </div>

        </section>

        <section class="question-card">

            <p class="question-instruction">
                Hitung penjumlahan berikut.
            </p>

            <div id="question"></div>

        </section>

    </main>

    <footer class="site-footer">

        <div class="footer-inner">

            <div class="footer-brand">

                <img src="/assets/mimi.png" alt="Mimi Matematika" />

                <div>
                    <strong>Mimi Matematika</strong>
                    <span>
                        Langkah kecil hari ini, prestasi besar nanti.
                    </span>
                </div>

            </div>

            <div class="footer-links">
                <a href="/belajar">Belajar</a>
                <a href="/ngobrol">Mimi Ngobrol</a>
                <a href="/permainan">Permainan</a>
            </div>

        </div>

        <div class="footer-bottom">
            © 2026 Mimi Matematika
        </div>

    </footer>
</MainLayout>


<style>

.game-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px 12px;
}

.game-topbar {
    min-height: 42px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 2px;
}

.back-link {
    color: #39704b;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
}

.game-number {
    color: #718078;
    font-size: 12px;
    font-weight: 700;
}

.exercise-banner {
    width: 100%;
    overflow: hidden;
    margin: 0;
    line-height: 0;
}

.exercise-banner img {
    display: block;
    width: 100%;
    height: auto;
}

.exercise-info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: -12px;
    margin-bottom: 8px;
}

.lesson-badge {
    display: inline-flex;
    padding: 5px 10px;
    border-radius: 999px;
    background: #e7f3ea;
    color: #39704b;
    font-size: 10px;
    font-weight: 800;
}

.exercise-info h1 {
    margin: 5px 0 0;
    color: #173f4b;
    font-size: 25px;
    line-height: 1.15;
}

.exercise-info p {
    margin: 5px 0 0;
    color: #718078;
    font-size: 11px;
}

.progress {
    color: #718078;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.mode-selector {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin: 8px 0 6px;
}

.mode-button {
    border: 2px solid #dce9df;
    border-radius: 12px;
    padding: 8px 10px;
    background: #ffffff;
    color: #718078;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
}

.mode-button.active {
    background: #e8f5eb;
    border-color: #9fc9ad;
    color: #39704b;
}

#mimi-area {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    margin: 0 0 3px;
}

#mimi-image {
    width: 50px;
    height: 50px;
    object-fit: contain;
}

.mimi-message {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 7px 12px;
    border-radius: 14px;
    background: #eef8f0;
    color: #39704b;
    font-size: 11px;
    font-weight: 600;
}

.question-card {
    width: 100%;
    padding: 16px;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 5px 18px rgba(55, 80, 65, 0.07);
}

.question-instruction {
    margin: 0 0 10px;
    color: #718078;
    font-size: 11px;
    text-align: center;
}

:global(.addition-skill-worksheet) {
    text-align: center;
}

:global(.addition-problem) {
    min-height: 145px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    color: #173f4b;
    font-size: 48px;
    font-weight: 800;
}

:global(.addition-operator),
:global(.addition-equals) {
    color: #718078;
}

:global(.typed-answer) {
    width: 82px;
    height: 62px;
    border: 3px solid #9fc9ad;
    border-radius: 15px;
    background: #f7fbf8;
    color: #173f4b;
    font-family: inherit;
    font-size: 34px;
    font-weight: 800;
    text-align: center;
    outline: none;
    box-sizing: border-box;
}

:global(.typed-answer:focus) {
    border-color: #39704b;
    background: #ffffff;
}

:global(.check-writing) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 150px;
    margin-top: 10px;
    padding: 11px 18px;
    border: none;
    border-radius: 13px;
    background: #39704b;
    color: #ffffff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
}

:global(.check-writing:hover) {
    opacity: 0.92;
}

:global(.check-writing:disabled) {
    opacity: 0.6;
    cursor: default;
}

:global(.typed-answer-hint) {
    margin-top: 9px;
    color: #718078;
    font-size: 10px;
}

:global(.missing-number) {
    color: #9fc9ad;
}

#mimi-image.correct {
    animation: mimiJump 0.55s ease;
}

#mimi-image.wrong {
    animation: mimiShake 0.45s ease;
}

@keyframes mimiJump {
    0% {
        transform: translateY(0);
    }

    40% {
        transform: translateY(-12px);
    }

    70% {
        transform: translateY(0);
    }

    100% {
        transform: translateY(-2px);
    }
}

@keyframes mimiShake {
    0%,
    100% {
        transform: translateX(0);
    }

    25% {
        transform: translateX(-6px);
    }

    50% {
        transform: translateX(6px);
    }

    75% {
        transform: translateX(-4px);
    }
}

.site-footer {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    background: #e8f6ec;
}

.site-footer .footer-inner {
    width: 100%;
    min-height: 64px;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.site-footer .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
}

.site-footer .footer-brand img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

.site-footer .footer-brand > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.site-footer .footer-brand strong {
    font-size: 13px;
    line-height: 1.1;
}

.site-footer .footer-brand span {
    font-size: 10px;
    line-height: 1.2;
}

.site-footer .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
}

.site-footer .footer-links a {
    color: inherit;
    font-size: 11px;
    text-decoration: none;
}

.site-footer .footer-bottom {
    padding: 7px 24px 9px;
    font-size: 9px;
}

@media (max-width: 600px) {

    .game-page {
        padding: 0 12px 10px;
    }

      .exercise-info {
        display: block;
        width: 100%;
        margin-top: -7px;
        margin-bottom: 8px;
        text-align: left !important;
    }

    .exercise-info > div:first-child {
        display: block;
        width: 100%;
        text-align: left !important;
    }

    .exercise-info .lesson-badge {
        display: inline-flex;
        text-align: left !important;
    }

    .exercise-info h1 {
        width: 100%;
        margin: 5px 0 0;
        text-align: left !important;
        font-size: 22px;
    }

    .exercise-info p {
        width: 100%;
        margin: 5px 0 0;
        text-align: left !important;
        font-size: 10px;
    }

    .exercise-info .progress {
        width: 100%;
        margin-top: 3px;
        text-align: right !important;
        font-size: 9px;
    }

    .exercise-info h1 {
        font-size: 22px;
    }

    .exercise-info p {
        font-size: 10px;
    }

    .progress {
        font-size: 9px;
    }

    .mode-selector {
        grid-template-columns: 1fr 1fr;
        gap: 5px;
    }

    .mode-button {
        padding: 8px 4px;
        border-radius: 10px;
        font-size: 9px;
    }

    #mimi-area {
        min-height: 44px;
    }

    #mimi-image {
        width: 44px;
        height: 44px;
    }

    .mimi-message {
        padding: 6px 9px;
        font-size: 10px;
    }

    .question-card {
        padding: 11px;
        border-radius: 17px;
    }

    :global(.addition-problem) {
        min-height: 120px;
        gap: 9px;
        font-size: 34px;
    }

    :global(.typed-answer) {
        width: 58px;
        height: 48px;
        border-width: 2px;
        border-radius: 12px;
        font-size: 27px;
    }

    :global(.check-writing) {
        min-width: 130px;
        margin-top: 7px;
        padding: 9px 14px;
        font-size: 10px;
    }

    :global(.typed-answer-hint) {
        font-size: 9px;
    }

    .site-footer .footer-inner {
        padding: 10px 12px;
    }

    .site-footer .footer-links {
        gap: 9px;
    }

    .site-footer .footer-links a {
        font-size: 9px;
    }

    .site-footer .footer-bottom {
        padding: 6px 12px 8px;
    }
}

</style>


<script>

const totalQuestions = 10;

let questionNumber = 0;
let score = 0;

let additionSkill = "basic";
let correctAnswer = 0;
let answering = false;

const questionElement =
    document.getElementById("question");

const progressElement =
    document.getElementById("progress");

const mimiElement =
    document.getElementById("mimi-image");

const mimiMessage =
    document.getElementById("mimi-message");

const basicMode =
    document.getElementById("basic-mode");

const to10Mode =
    document.getElementById("to10-mode");

const to18Mode =
    document.getElementById("to18-mode");

const challengeMode =
    document.getElementById("challenge-mode");


const modeButtons = [
    basicMode,
    to10Mode,
    to18Mode,
    challengeMode
];


function setSkill(skill, button) {

    additionSkill = skill;

    modeButtons.forEach(
        item => item.classList.remove("active")
    );

    button.classList.add("active");

    questionNumber = 0;
    score = 0;

    generateQuestion();

}


basicMode.addEventListener(
    "click",
    () => setSkill("basic", basicMode)
);

to10Mode.addEventListener(
    "click",
    () => setSkill("to10", to10Mode)
);

to18Mode.addEventListener(
    "click",
    () => setSkill("to18", to18Mode)
);

challengeMode.addEventListener(
    "click",
    () => setSkill("challenge", challengeMode)
);


/* ========================================
   GENERATE
======================================== */

function generateQuestion() {

    answering = false;

    questionNumber++;

    progressElement.textContent =
        `Soal ${questionNumber} dari ${totalQuestions}`;

    mimiMessage.textContent =
        "Yuk, hitung bersama Mimi! 😊";

    generateAdditionQuestion();

}


/* ========================================
   PENJUMLAHAN SATUAN
======================================== */

function generateAdditionQuestion() {

    if (additionSkill === "basic") {

        let number1;
        let number2;

        do {

            number1 =
                Math.floor(Math.random() * 10);

            number2 =
                Math.floor(Math.random() * 10);

        } while (
            number1 + number2 > 10
        );

        correctAnswer =
            number1 + number2;

        createAdditionWorksheet(
            number1,
            number2
        );

    }


    else if (additionSkill === "to10") {

        let number1;
        let number2;

        do {

            number1 =
                Math.floor(Math.random() * 9) + 1;

            number2 =
                Math.floor(Math.random() * 9) + 1;

        } while (
            number1 + number2 < 5 ||
            number1 + number2 > 10
        );

        correctAnswer =
            number1 + number2;

        createAdditionWorksheet(
            number1,
            number2
        );

    }


    else if (additionSkill === "to18") {

        let number1;
        let number2;

        do {

            number1 =
                Math.floor(Math.random() * 9) + 1;

            number2 =
                Math.floor(Math.random() * 9) + 1;

        } while (
            number1 + number2 <= 10 ||
            number1 + number2 > 18
        );

        correctAnswer =
            number1 + number2;

        createAdditionWorksheet(
            number1,
            number2
        );

    }


    else {

        let number1;
        let missingNumber;
        let total;

        do {

            number1 =
                Math.floor(Math.random() * 9) + 1;

            missingNumber =
                Math.floor(Math.random() * 9) + 1;

            total =
                number1 + missingNumber;

        } while (
            total > 18
        );

        correctAnswer =
            missingNumber;

        createMissingAdditionWorksheet(
            number1,
            total
        );

    }

}


/* ========================================
   SOAL BIASA
======================================== */

function createAdditionWorksheet(
    number1,
    number2
) {

    questionElement.innerHTML = `

        <div class="addition-skill-worksheet">

            <div class="addition-problem">

                <span>${number1}</span>

                <span class="addition-operator">
                    +
                </span>

                <span>${number2}</span>

                <span class="addition-equals">
                    =
                </span>

                <input
                    id="typed-answer"
                    class="typed-answer"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    maxlength="2"
                    placeholder="?"
                    aria-label="Ketik jawaban"
                >

            </div>

            <button
                id="check-writing"
                class="check-writing addition"
                type="button"
            >
                Cek Jawaban
                <span>▶</span>
            </button>

            <div class="typed-answer-hint">
                🔢 Ketik jawabanmu di kotak
            </div>

        </div>

    `;

    setupTypedAnswer(correctAnswer);

}


/* ========================================
   TANTANGAN
======================================== */

function createMissingAdditionWorksheet(
    number1,
    total
) {

    questionElement.innerHTML = `

        <div class="addition-skill-worksheet">

            <div class="addition-problem">

                <span>${number1}</span>

                <span class="addition-operator">
                    +
                </span>

                <span class="missing-number">
                    ?
                </span>

                <span class="addition-equals">
                    =
                </span>

                <span>${total}</span>

            </div>

            <div class="typed-answer-row">

                <input
                    id="typed-answer"
                    class="typed-answer"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    maxlength="2"
                    placeholder="?"
                    aria-label="Ketik angka yang hilang"
                >

                <button
                    id="check-writing"
                    class="check-writing addition"
                    type="button"
                >
                    Cek Jawaban
                    <span>▶</span>
                </button>

            </div>

            <div class="typed-answer-hint">
                🔢 Ketik angka yang hilang
            </div>

        </div>

    `;

    setupTypedAnswer(correctAnswer);

}


/* ========================================
   INPUT
======================================== */

function setupTypedAnswer(answer) {

    const input =
        document.getElementById(
            "typed-answer"
        );

    const checkButton =
        document.getElementById(
            "check-writing"
        );

    if (!input || !checkButton) {
        return;
    }


    input.addEventListener(
        "input",
        () => {

            input.value =
                input.value.replace(
                    /[^0-9]/g,
                    ""
                );

        }
    );


    checkButton.addEventListener(
        "click",
        () => {

            checkTypedAnswer(answer);

        }
    );


    input.addEventListener(
        "keydown",
        event => {

            if (
                event.key === "Enter"
            ) {

                event.preventDefault();

                checkTypedAnswer(answer);

            }

        }
    );


    setTimeout(
        () => {
            input.focus();
        },
        100
    );

}


/* ========================================
   CHECK
======================================== */

function checkTypedAnswer(answer) {

    if (answering) {
        return;
    }

    const input =
        document.getElementById(
            "typed-answer"
        );

    const checkButton =
        document.getElementById(
            "check-writing"
        );

    if (!input) {
        return;
    }


    const userValue =
        input.value.trim();


    if (!userValue) {

        mimiMessage.textContent =
            "Ketik jawabannya dulu ya 🔢";

        input.focus();

        return;

    }


    if (
        Number(userValue) ===
        Number(answer)
    ) {

        checkTypedCorrect();

    }

    else {

        checkTypedWrong();

    }

}


/* ========================================
   BENAR
======================================== */

function checkTypedCorrect() {

    if (answering) {
        return;
    }

    answering = true;

    score += 10;

    mimiMessage.textContent =
        "Hebat! Jawabanmu benar! 🎉";

    launchConfetti();

    mimiElement.classList.remove(
        "wrong",
        "correct"
    );

    void mimiElement.offsetWidth;

    mimiElement.classList.add(
        "correct"
    );


    const input =
        document.getElementById(
            "typed-answer"
        );

    const checkButton =
        document.getElementById(
            "check-writing"
        );


    if (input) {
        input.disabled = true;
    }

    if (checkButton) {

        checkButton.disabled = true;

        checkButton.innerHTML =
            "Benar! 🎉";

    }


    setTimeout(
        () => {

            if (questionNumber >= totalQuestions) {
                window.location.href =
                    `/hasil-latihan?kelas=2&latihan=04&skor=${score}`;
            } else {
                generateQuestion();
            }

        },
        900
    );

}


/* ========================================
   SALAH
======================================== */

function checkTypedWrong() {

    mimiMessage.textContent =
        "Belum tepat. Coba lagi! 💪";

    mimiElement.classList.remove(
        "correct",
        "wrong"
    );

    void mimiElement.offsetWidth;

    mimiElement.classList.add(
        "wrong"
    );


    const input =
        document.getElementById(
            "typed-answer"
        );

    const checkButton =
        document.getElementById(
            "check-writing"
        );


    if (checkButton) {

        checkButton.disabled = false;

        checkButton.innerHTML =
            'Coba Lagi <span>↻</span>';

    }


    if (input) {

        input.focus();

        input.select();

    }

}


/* ========================================
   CONFETTI
======================================== */

function launchConfetti() {

    const container =
        document.createElement("div");

    container.style.position = "fixed";
    container.style.left = "0";
    container.style.top = "0";

    container.style.width = "100vw";
    container.style.height = "100vh";

    container.style.pointerEvents = "none";
    container.style.overflow = "hidden";

    container.style.zIndex =
        "999999";

    document.body.appendChild(
        container
    );


    const colors = [
        "#7FAF8B",
        "#E8B86D",
        "#D98282",
        "#8FA8C7",
        "#C99A6B",
        "#F3C6C6",
        "#A8D8B9"
    ];


    for (
        let i = 0;
        i < 100;
        i++
    ) {

        const piece =
            document.createElement("div");

        const size =
            8 + Math.random() * 7;

        piece.style.position =
            "absolute";

        piece.style.width =
            `${size}px`;

        piece.style.height =
            `${size * 1.5}px`;

        piece.style.backgroundColor =
            colors[
                Math.floor(
                    Math.random() *
                    colors.length
                )
            ];

        piece.style.left =
            `${Math.random() * 100}vw`;

        piece.style.top =
            "-30px";

        piece.style.borderRadius =
            "3px";

        container.appendChild(
            piece
        );


        const x =
            (Math.random() - 0.5) * 300;

        const y =
            500 + Math.random() * 400;

        const rotation =
            360 + Math.random() * 720;


        piece.animate(
            [
                {
                    transform:
                        "translate3d(0, 0, 0) rotate(0deg)",
                    opacity: 1
                },

                {
                    transform:
                        `translate3d(${x}px, ${y}px, 0) rotate(${rotation}deg)`,
                    opacity: 0
                }
            ],
            {
                duration:
                    1800 +
                    Math.random() * 1000,

                delay:
                    Math.random() * 200,

                easing:
                    "cubic-bezier(.2,.8,.3,1)",

                fill: "forwards"
            }
        );

    }


    setTimeout(
        () => {

            container.remove();

        },
        3500
    );

}


/* ========================================
   START
======================================== */

generateQuestion();

</script>