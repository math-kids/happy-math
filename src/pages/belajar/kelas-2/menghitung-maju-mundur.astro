---
import MainLayout from "../../../layouts/MainLayout.astro";
import Header from "../../../components/Header.astro";
---

<MainLayout title="Menghitung Maju dan Mundur - Mimi Matematika">
    <Header />

    <main class="game-page">
        <div class="game-topbar">
            <a href="/belajar/kelas-2" class="back-link">← Kembali</a>
            <span class="game-number">Kelas 2 SD</span>
            <div></div>
        </div>

        <!-- BANNER -->
        <section class="exercise-banner">
            <img src="/assets/banner-latihan.png" alt="Mimi Matematika" />
        </section>

        <!-- INFO -->
        <section class="exercise-info">
            <div>
                <span class="lesson-badge">Latihan 02</span>
                <h1>Menghitung Maju dan Mundur</h1>
                <p>Lengkapi urutan angka yang hilang.</p>
            </div>

            <div class="progress" id="progress">Soal 1 dari 1</div>
        </section>

        <!-- MODE -->
        <section class="mode-selector">
            <button id="forward-mode" class="mode-button active" type="button">
                🗺️ Menghitung Maju
            </button>

            <button id="backward-mode" class="mode-button" type="button">
                🚗 Menghitung Mundur
            </button>
        </section>

        <!-- MIMI -->
        <section id="mimi-area">
            <img id="mimi-image" src="/assets/mimi.png" alt="Mimi" />

            <div class="mimi-message" id="mimi-message">
                Yuk, lengkapi angka yang hilang! 😊
            </div>
        </section>

        <!-- QUESTION -->
        <section class="question-card">
            <p class="question-instruction" id="question-instruction">
                Ikuti jalur dan isi angka yang hilang.
            </p>

            <div class="counting-map" id="counting-map">
                <div class="route" id="route"></div>
            </div>

            <div class="answer-area">
                <input
                    id="typed-answer"
                    class="typed-answer"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    maxlength="3"
                    placeholder="?"
                    aria-label="Ketik angka yang hilang"
                />

                <button id="check-writing" class="check-writing" type="button">
                    Cek Jawaban <span>▶</span>
                </button>
            </div>
        </section>

        <!-- FOOTER -->
        <footer class="site-footer">
            <div class="footer-inner">
                <div class="footer-brand">
                    <img src="/assets/mimi.png" alt="Mimi Matematika" />

                    <div>
                        <strong>Mimi Matematika</strong>
                        <span>
                            Langkah kecil hari ini, prestasi besar nanti.
                        </span>
                    </div>
                </div>

                <div class="footer-links">
                    <a href="/belajar">Belajar</a>
                    <a href="/ngobrol">Mimi Ngobrol</a>
                    <a href="/permainan">Permainan</a>
                </div>
            </div>

            <div class="footer-bottom">© 2026 Mimi Matematika</div>
        </footer>
    </main>
</MainLayout>

<style>
    /* =========================================
   PAGE
========================================= */

    .game-page {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 24px 12px;
    }

    /* =========================================
   TOPBAR
========================================= */

    .game-topbar {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        margin-bottom: 0;
    }

    .back-link {
        color: #718078;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }

    .back-link:hover {
        color: #39704b;
    }

    .game-number {
        color: #8b918b;
        font-size: 11px;
        font-weight: 700;
    }

    /* =========================================
   BANNER
========================================= */

.exercise-banner {
    width: 100%;
    overflow: hidden;
    margin: 0;
    line-height: 0;
}

.exercise-banner img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
}




    /* =========================================
   INFO
========================================= */

    .exercise-info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: -12px;
    margin-bottom: 0;
}

    .lesson-badge {
        display: inline-block;
        padding: 6px 12px;
        background: #dff3e5;
        color: #39704b;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .exercise-info h1 {
        margin: 0;
        color: #173f4b;
        font-size: 25px;
        line-height: 1.15;
    }

    .exercise-info p {
        margin: 4px 0 0;
        color: #718078;
        font-size: 12px;
    }

    .progress {
        flex-shrink: 0;
        color: #8b918b;
        font-size: 13px;
        font-weight: 600;
    }

    /* =========================================
   MODE
========================================= */

    .mode-selector {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin: 7px 0 2px;
    }

    .mode-button {
        border: 1px solid #d8e4da;
        background: #f5f8f4;
        color: #68756d;
        border-radius: 14px;
        padding: 7px 14px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition:
            background 0.15s,
            border-color 0.15s,
            transform 0.15s;
    }

    .mode-button:hover {
        transform: translateY(-1px);
    }

    .mode-button.active {
        background: #dff3e5;
        border-color: #9fc9ad;
        color: #39704b;
    }

    /* =========================================
   MIMI
========================================= */

    #mimi-area {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 52px;
        margin: 0 0 3px;
    }

    #mimi-image {
        display: block;
        width: 50px;
        height: 50px;
        object-fit: contain;
    }

    .mimi-message {
        min-width: 190px;
        padding: 9px 14px;
        background: #edf3eb;
        border-radius: 17px;
        color: #526258;
        font-size: 12px;
    }

    /* =========================================
   QUESTION
========================================= */

    .question-card {
        background: #f8f3e9;
        border-radius: 24px;
        padding: 12px;
        margin-bottom: 14px;
    }

    .question-instruction {
        margin: 0 0 9px;
        text-align: center;
        color: #7c837c;
        font-size: 13px;
    }

    /* =========================================
   MAP
========================================= */

    .counting-map {
        position: relative;
        width: 100%;
        aspect-ratio: 4 / 2.85;
        min-height: 260px;
        overflow: hidden;
        border-radius: 24px;
        background-image: url("/assets/treasuremap.png");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
    }

    .counting-map.backward {
        background-image: url("/assets/citymap.png");
    }

    /* =========================================
   ROUTE
========================================= */

    .route {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 5;
    }

   /* =========================================
   NUMBER STEPS
========================================= */

:global(.map-step) {
    position: absolute;
    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    box-sizing: border-box;

    margin: 0;
    padding: 0;

    background: #fffaf2;
    border: 4px solid #d9b58d;
    border-radius: 18px;

    color: #29372f;
    font-size: 26px;
    font-weight: 800;
    line-height: 1;

    text-align: center;
    text-indent: 0;

    z-index: 6;
    box-shadow: 0 3px 8px rgba(80, 70, 50, 0.12);
}

/* INPUT DI ATAS PETA
   Ukuran dan tampilan SAMA PERSIS dengan kotak angka */
:global(input.map-answer-input) {
    position: absolute !important;

    width: 58px !important;
    min-width: 58px !important;
    max-width: 58px !important;

    height: 58px !important;
    min-height: 58px !important;
    max-height: 58px !important;

    margin: 0 !important;
    padding: 0 !important;

    box-sizing: border-box !important;

    background: #fffaf2 !important;
    border: 4px solid #d9b58d !important;
    border-radius: 18px !important;

    color: #29372f !important;

    text-align: center !important;
    text-indent: 0 !important;

    font-size: 26px !important;
    font-weight: 800 !important;
    line-height: 58px !important;

    outline: none !important;

    appearance: none !important;
    -webkit-appearance: none !important;

    z-index: 10 !important;
}

:global(input.map-answer-input::placeholder) {
    color: #29372f;
    opacity: 1;
    text-align: center;
}

/* =========================================
   FORWARD MAP
========================================= */

:global(.counting-map:not(.backward) .map-step-1) {
    left: 35%;
    top: 20%;
}

:global(.counting-map:not(.backward) .map-step-2) {
    left: 36%;
    top: 44%;
}

:global(.counting-map:not(.backward) .map-step-3) {
    left: 50%;
    top: 57%;
}

:global(.counting-map:not(.backward) .map-step-4) {
    left: 66%;
    top: 67%;
}

:global(.counting-map:not(.backward) .map-step-5) {
    left: 82%;
    top: 64%;
}

/* =========================================
   BACKWARD MAP
========================================= */

:global(.counting-map.backward .map-step-1) {
    left: 34%;
    top: 18%;
}

:global(.counting-map.backward .map-step-2) {
    left: 63%;
    top: 22%;
}

:global(.counting-map.backward .map-step-3) {
    left: 50%;
    top: 42%;
}

:global(.counting-map.backward .map-step-4) {
    left: 68%;
    top: 58%;
}

:global(.counting-map.backward .map-step-5) {
    left: 53%;
    top: 78%;
}

/* =========================================
   MISSING NUMBER
========================================= */

:global(.map-step.missing) {
    background: #fffaf2;
    border-color: #d9b58d;
    color: #29372f;
    font-size: 30px;
}

/* =========================================
   MOBILE NUMBER BOXES
   SEMUA KOTAK SAMA BESAR
========================================= */

@media (max-width: 600px) {

    :global(.map-step) {
        width: 35px !important;
        min-width: 35px !important;
        max-width: 35px !important;

        height: 35px !important;
        min-height: 35px !important;
        max-height: 35px !important;

        border-width: 3px !important;
        border-radius: 14px !important;

        padding: 0 !important;
        margin: 0 !important;

        font-size: 18px !important;
        line-height: 1 !important;

        text-align: center !important;
        text-indent: 0 !important;
    }

    /* KOTAK ? DI DALAM GAMBAR
       HARUS SAMA PERSIS UKURANNYA */
    :global(input.map-answer-input) {
        width: 35px !important;
        min-width: 35px !important;
        max-width: 35px !important;

        height: 35px !important;
        min-height: 35px !important;
        max-height: 35px !important;

        border-width: 3px !important;
        border-radius: 14px !important;

        padding: 0 !important;
        margin: 0 !important;

        font-size: 18px !important;
        line-height: 35px !important;

        text-align: center !important;
        text-indent: 0 !important;
    }

    :global(input.map-answer-input::placeholder) {
        text-align: center !important;
        color: #29372f !important;
        opacity: 1 !important;
    }

    :global(input.map-answer-input:focus) {
        border-color: #d9b58d !important;
        box-shadow: 0 0 0 3px rgba(126, 175, 139, 0.15);
    }

    :global(.map-step.missing) {
        font-size: 18px !important;
    }
}
    /* =========================================
   MIMI ANIMATION
========================================= */

    .mimi-jump {
        animation: mimiJump 0.55s ease;
    }

    @keyframes mimiJump {
        0% {
            transform: translateY(0);
        }

        40% {
            transform: translateY(-14px) rotate(-4deg);
        }

        70% {
            transform: translateY(-5px) rotate(4deg);
        }

        100% {
            transform: translateY(0);
        }
    }

    .mimi-shake {
        animation: mimiShake 0.45s ease;
    }

    @keyframes mimiShake {
        0%,
        100% {
            transform: translateX(0);
        }

        20% {
            transform: translateX(-7px);
        }

        40% {
            transform: translateX(7px);
        }

        60% {
            transform: translateX(-5px);
        }

        80% {
            transform: translateX(5px);
        }
    }

    /* =========================================
   FOOTER
========================================= */

    .site-footer {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        background: #e8f6ec;
    }

    .site-footer .footer-inner {
        width: 100%;
        min-height: 64px;
        padding: 12px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-sizing: border-box;
    }

    .site-footer .footer-brand {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .site-footer .footer-brand img {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    .site-footer .footer-brand > div {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .site-footer .footer-brand strong {
        font-size: 13px;
        line-height: 1.1;
    }

    .site-footer .footer-brand span {
        font-size: 10px;
        line-height: 1.2;
    }

    .site-footer .footer-links {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .site-footer .footer-links a {
        font-size: 11px;
    }

    .site-footer .footer-bottom {
        padding: 7px 24px 9px;
        font-size: 9px;
    }
/* =========================================
   ANSWER AREA
========================================= */

.answer-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 12px;
}

.typed-answer {
    width: 110px;
    height: 52px;

    border: 3px solid #9fc9ad;
    border-radius: 15px;

    background: #ffffff;
    color: #29372f;

    box-sizing: border-box;

    text-align: center;
    font-size: 25px;
    font-weight: 800;

    outline: none;
}

.typed-answer:focus {
    border-color: #6eaa81;
    box-shadow: 0 0 0 3px rgba(126, 175, 139, 0.15);
}

.typed-answer::placeholder {
    color: #9fc9ad;
    opacity: 1;
}

.check-writing {
    height: 52px;
    min-height: 52px;

    border: none;
    border-radius: 15px;

    padding: 0 18px;

    background: #7faf8b;
    color: #ffffff;

    font-family: inherit;
    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;

    box-sizing: border-box;
    white-space: nowrap;

    transition:
        transform 0.15s,
        box-shadow 0.15s;
}

.check-writing:hover {
    transform: translateY(-1px);
    box-shadow: 0 5px 12px rgba(70, 110, 80, 0.18);
}

.check-writing span {
    margin-left: 0;
}
    /* =========================================
   MOBILE
========================================= */

    @media (max-width: 600px) {
        .game-page {
            padding: 0 14px 20px;
        }

        .game-number {
            font-size: 10px;
        }

        .back-link {
            font-size: 11px;
        }

        .exercise-info {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }

        .exercise-info h1 {
            font-size: 21px;
        }

        .exercise-info p {
            font-size: 11px;
        }

        .progress {
            align-self: flex-end;
        }

        .mode-selector {
            width: 100%;
            gap: 6px;
            margin-top: 6px;
        }

        .mode-button {
            flex: 1;
            padding: 7px 5px;
            font-size: 10px;
        }

        #mimi-area {
            gap: 8px;
            min-height: 48px;
        }

        #mimi-image {
            width: 48px;
            height: 48px;
        }

        .mimi-message {
            min-width: 0;
            width: 100%;
            padding: 8px 11px;
            font-size: 11px;
        }

        .question-card {
            padding: 10px;
            border-radius: 20px;
        }

        .question-instruction {
            font-size: 11px;
            margin-bottom: 7px;
        }

        .counting-map {
            min-height: 210px;
            border-radius: 19px;
        }
        :global(.map-step) {
            width: 35px;
            height: 35px;
            border-width: 3px;
            border-radius: 14px;
            font-size: 18px;
        }

        :global(.map-step.missing) {
            background: #fffaf2;
            border-color: #d9b58d;
            color: #29372f;
            font-size: 18px;
        }

        :global(.map-answer-input) {
            position: absolute;
            width: 35px;
            height: 35px;
            padding: 0;
            border: 3px solid #d9b58d;
            border-radius: 14px;
            background: #fffaf2;
            color: #29372f;
            box-sizing: border-box;
            text-align: center;
            font-size: 18px;
            font-weight: 800;
            outline: none;
            z-index: 10;
            cursor: text;
        }
        :global(.map-step.sequence-answer) {
            width: 35px !important;
            height: 35px !important;
            padding: 0;
            border: 3px solid #d9b58d !important;
            border-radius: 14px !important;
            background: #fffaf2 !important;
            color: #29372f !important;
            box-sizing: border-box;
            text-align: center;
            font-size: 18px !important;
            font-weight: 800;
        }

        :global(.map-answer-input:focus) {
            border-color: #6eaa81;
            box-shadow: 0 0 0 4px rgba(126, 175, 139, 0.16);
        }

        @media (max-width: 600px) {
            :global(.map-answer-input) {
                width: 46px;
                height: 46px;
                border-width: 3px;
                border-radius: 14px;
                font-size: 20px;
            }
        }

        .answer-area {
            margin-top: 9px;
            gap: 7px;
        }

        .typed-answer {
            width: 85px;
            height: 48px;
            font-size: 22px;
        }

        .check-writing {
            min-height: 48px;
            padding: 0 13px;
            font-size: 12px;
        }

        .site-footer .footer-inner {
            padding: 10px 14px;
        }

        .site-footer .footer-links {
            gap: 10px;
        }

        .site-footer .footer-links a {
            font-size: 9px;
        }
        :global(.map-step) {
            width: 35px;
            height: 35px;
            border-width: 3px;
            border-radius: 14px;
            font-size: 18px;
        }

        :global(.map-step.missing) {
            font-size: 18px;
        }
    }
</style>

<script>
    const totalQuestions = 10;

    let questionNumber = 1;
    let correctAnswer = 0;
    let currentMode = "forward";
    let score = 0;

    const progress = document.querySelector("#progress");

    const route = document.querySelector("#route");

    const countingMap = document.querySelector("#counting-map");

    const typedAnswer = document.querySelector("#typed-answer");

    const checkWriting = document.querySelector("#check-writing");

    const mimiImage = document.querySelector("#mimi-image");

    const mimiMessage = document.querySelector("#mimi-message");

    const questionInstruction = document.querySelector("#question-instruction");

    const forwardMode = document.querySelector("#forward-mode");

    const backwardMode = document.querySelector("#backward-mode");

    if (
        !(progress instanceof HTMLElement) ||
        !(route instanceof HTMLElement) ||
        !(countingMap instanceof HTMLElement) ||
        !(typedAnswer instanceof HTMLInputElement) ||
        !(checkWriting instanceof HTMLButtonElement) ||
        !(mimiImage instanceof HTMLImageElement) ||
        !(mimiMessage instanceof HTMLElement) ||
        !(questionInstruction instanceof HTMLElement) ||
        !(forwardMode instanceof HTMLButtonElement) ||
        !(backwardMode instanceof HTMLButtonElement)
    ) {
        throw new Error("Elemen game tidak ditemukan.");
    }

    /* =========================================
       MODE FORWARD
    ========================================= */

    forwardMode.addEventListener("click", () => {
        currentMode = "forward";
        questionNumber = 1;
        score = 0;

        forwardMode.classList.add("active");
        backwardMode.classList.remove("active");

        questionInstruction.textContent = "Ikuti jalur dan hitung maju.";

        generateQuestion();
    });

    /* =========================================
       MODE BACKWARD
    ========================================= */

    backwardMode.addEventListener("click", () => {
        currentMode = "backward";
        questionNumber = 1;
        score = 0;

        backwardMode.classList.add("active");
        forwardMode.classList.remove("active");

        questionInstruction.textContent = "Ikuti jalur dan hitung mundur.";

        generateQuestion();
    });

    /* =========================================
       GENERATE QUESTION
    ========================================= */

    function generateQuestion() {
        typedAnswer.value = "";

        progress.textContent = `Soal ${questionNumber} dari ${totalQuestions}`;

        let min;
        let max;

        if (questionNumber <= 3) {
            min = 1;
            max = 30;
        } else if (questionNumber <= 6) {
            min = 31;
            max = 50;
        } else {
            min = 51;
            max = 100;
        }

        const isForward = currentMode === "forward";

        const start = isForward
            ? Math.floor(Math.random() * (max - min - 4)) + min
            : Math.floor(Math.random() * (max - min - 4)) + min + 4;

        const numbers = isForward
            ? [start, start + 1, start + 2, start + 3, start + 4]
            : [start, start - 1, start - 2, start - 3, start - 4];

        const missingIndex =
            questionNumber >= 7
                ? Math.floor(Math.random() * 4) + 1
                : Math.floor(Math.random() * 3) + 1;

        correctAnswer = numbers[missingIndex];

        /* BACKGROUND */

        if (isForward) {
            countingMap.classList.remove("backward");
        } else {
            countingMap.classList.add("backward");
        }

        /* NUMBERS */

        route.innerHTML = "";

        numbers.forEach((number, index) => {
            if (index === missingIndex) {
                const answerInput = document.createElement("input");

                answerInput.type = "text";
                answerInput.inputMode = "numeric";
                answerInput.autocomplete = "off";
                answerInput.maxLength = 3;

                answerInput.className = `map-step map-answer-input map-step-${index + 1}`;

                answerInput.placeholder = "?";

               
                answerInput.setAttribute(
                    "aria-label",
                    "Ketik angka yang hilang",
                );

                answerInput.addEventListener("input", () => {
                    answerInput.value = answerInput.value.replace(/\D/g, "");

                    typedAnswer.value = answerInput.value;
                });

                answerInput.addEventListener("keydown", (event) => {
                    if (event.key === "Enter") {
                        checkAnswer();
                    }
                });

                route.appendChild(answerInput);

                setTimeout(() => {
                    answerInput.focus();
                }, 50);
            } else {
                const step = document.createElement("div");

                step.className = `map-step map-step-${index + 1}`;

                step.textContent = String(number);

                route.appendChild(step);
            }
        });

        mimiMessage.textContent = isForward
            ? "Ayo hitung maju! 🗺️"
            : "Ayo hitung mundur! 🚗";

        typedAnswer.focus();
    }

    /* =========================================
       CHECK ANSWER
    ========================================= */

    checkWriting.addEventListener("click", checkAnswer);

    typedAnswer.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
            checkAnswer();
        }
    });

    function checkAnswer() {
        const value = typedAnswer.value.trim();

        if (value === "") {
            mimiMessage.textContent = "Isi jawabannya dulu ya 😊";

            typedAnswer.focus();
            return;
        }

        const answer = Number(value);

        if (answer === correctAnswer) {
            handleCorrect();
        } else {
            handleWrong();
        }
    }

    /* =========================================
       CORRECT
    ========================================= */

    function handleCorrect() {
        score += 10;

        mimiMessage.textContent = "Benar! Hebat sekali! 🎉";

        mimiImage.classList.remove("mimi-shake");

        void mimiImage.offsetWidth;

        mimiImage.classList.add("mimi-jump");

        launchConfetti();

        setTimeout(() => {
            mimiImage.classList.remove("mimi-jump");
        }, 600);

        if (questionNumber >= totalQuestions) {
            setTimeout(showResult, 700);
        } else {
            questionNumber++;

            setTimeout(generateQuestion, 700);
        }
    }

    /* =========================================
       WRONG
    ========================================= */

    function handleWrong() {
        mimiMessage.textContent = "Belum tepat. Coba lagi! 💪";

        mimiImage.classList.remove("mimi-jump");

        void mimiImage.offsetWidth;

        mimiImage.classList.add("mimi-shake");

        setTimeout(() => {
            mimiImage.classList.remove("mimi-shake");
        }, 500);

        typedAnswer.select();
    }

    /* =========================================
       RESULT
    ========================================= */

    function showResult() {
        window.location.href = `/hasil-latihan?kelas=2&latihan=02&skor=${score}`;
    }

    /* =========================================
       CONFETTI
    ========================================= */

    function launchConfetti() {
        const container = document.createElement("div");

        container.style.position = "fixed";
        container.style.left = "0";
        container.style.top = "0";
        container.style.width = "100vw";
        container.style.height = "100vh";
        container.style.pointerEvents = "none";
        container.style.overflow = "hidden";
        container.style.zIndex = "999999";

        document.body.appendChild(container);

        const colors = [
            "#7FAF8B",
            "#E8B86D",
            "#D98282",
            "#8FA8C7",
            "#C99A6B",
            "#F3C6C6",
            "#A8D8B9",
        ];

        for (let i = 0; i < 100; i++) {
            const piece = document.createElement("div");

            const size = 8 + Math.random() * 7;

            piece.style.position = "absolute";
            piece.style.width = `${size}px`;
            piece.style.height = `${size * 1.5}px`;

            piece.style.backgroundColor =
                colors[Math.floor(Math.random() * colors.length)];

            piece.style.left = `${Math.random() * 100}vw`;

            piece.style.top = "-30px";
            piece.style.borderRadius = "3px";

            container.appendChild(piece);

            const x = (Math.random() - 0.5) * 300;

            const y = 500 + Math.random() * 400;

            const rotation = 360 + Math.random() * 720;

            piece.animate(
                [
                    {
                        transform: "translate3d(0, 0, 0) rotate(0deg)",
                        opacity: 1,
                    },
                    {
                        transform: `translate3d(${x}px, ${y}px, 0) rotate(${rotation}deg)`,
                        opacity: 0,
                    },
                ],
                {
                    duration: 1800 + Math.random() * 1000,
                    delay: Math.random() * 200,
                    easing: "cubic-bezier(.2,.8,.3,1)",
                    fill: "forwards",
                },
            );
        }

        setTimeout(() => {
            container.remove();
        }, 3500);
    }

    /* =========================================
       START
    ========================================= */

    generateQuestion();
</script>
