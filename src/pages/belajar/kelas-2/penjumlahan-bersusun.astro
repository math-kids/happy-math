---
import MainLayout from "../../../layouts/MainLayout.astro";
import Header from "../../../components/Header.astro";
---

<MainLayout title="Penjumlahan Bersusun - Mimi Matematika">
    <Header />

    <main class="game-page">

        <div class="game-topbar">
            <a href="/belajar/kelas-2" class="back-link">← Kembali</a>
            <span class="game-number">Kelas 2 SD</span>
            <div></div>
        </div>

        <section class="exercise-banner">
            <img src="/assets/banner-latihan.png" alt="Mimi Matematika" />
        </section>

        <section class="exercise-info">
            <div>
                <span class="lesson-badge">Latihan 06</span>
                <h1>Penjumlahan Bersusun</h1>
                <p>Yuk belajar menjumlahkan bilangan secara bersusun.</p>
            </div>

            <div class="progress" id="progress">
                Soal 1 dari 10
            </div>
        </section>

        <section class="mode-selector">

            <button id="no-carry-mode" class="mode-button active" type="button">
                📝 Tanpa Menyimpan
            </button>

            <button id="carry-mode" class="mode-button" type="button">
                ➕ Dengan Menyimpan
            </button>

            <button id="word-problem-mode" class="mode-button" type="button">
                📖 Soal Cerita
            </button>

        </section>

        <section id="mimi-area">
            <img id="mimi-image" src="/assets/mimi.png" alt="Mimi" />

            <div class="mimi-message" id="mimi-message">
                Yuk, hitung bersama Mimi! 😊
            </div>
        </section>

        <section class="question-card">
            <div id="question"></div>
        </section>

    </main>

    <footer class="site-footer">
        <div class="footer-inner">

            <div class="footer-brand">
                <img src="/assets/mimi.png" alt="Mimi Matematika" />

                <div>
                    <strong>Mimi Matematika</strong>
                    <span>
                        Langkah kecil hari ini, prestasi besar nanti.
                    </span>
                </div>
            </div>

            <div class="footer-links">
                <a href="/belajar">Belajar</a>
                <a href="/ngobrol">Mimi Ngobrol</a>
                <a href="/permainan">Permainan</a>
            </div>

        </div>

        <div class="footer-bottom">
            © 2026 Mimi Matematika
        </div>
    </footer>
</MainLayout>

<style>
.game-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px 12px;
    box-sizing: border-box;
}

.game-topbar {
    min-height: 42px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 2px;
}

.back-link {
    color: #39704b;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
}

.game-number {
    color: #718078;
    font-size: 12px;
    font-weight: 700;
}

.exercise-banner {
    width: 100%;
    overflow: hidden;
    margin: 0;
    line-height: 0;
}

.exercise-banner img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
}

.exercise-info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: -12px;
    margin-bottom: 8px;
}

.exercise-info > div:first-child {
    text-align: left;
}

.lesson-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border-radius: 999px;
    background: #e7f3ea;
    color: #39704b;
    font-size: 10px;
    font-weight: 800;
}

.exercise-info h1 {
    margin: 5px 0 0;
    color: #173f4b;
    font-size: 25px;
    line-height: 1.15;
    text-align: left;
}

.exercise-info p {
    margin: 5px 0 0;
    color: #718078;
    font-size: 11px;
    text-align: left;
}

.progress {
    color: #718078;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.mode-selector {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 8px 0 6px;
}

.mode-button {
    border: 2px solid #dce9df;
    border-radius: 12px;
    padding: 9px 10px;
    background: #ffffff;
    color: #718078;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
}

.mode-button.active {
    background: #e8f5eb;
    border-color: #9fc9ad;
    color: #39704b;
}

#mimi-area {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    margin: 0 0 3px;
}

#mimi-image {
    width: 50px;
    height: 50px;
    object-fit: contain;
}

.mimi-message {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 7px 12px;
    border-radius: 14px;
    background: #eef8f0;
    color: #39704b;
    font-size: 11px;
    font-weight: 600;
}

.question-card {
    width: 100%;
    padding: 16px;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 5px 18px rgba(55, 80, 65, 0.07);
    box-sizing: border-box;
}

:global(.stacked-addition-worksheet) {
    text-align: center;
}

:global(.stacked-addition-problem) {
    position: relative;
    width: min(300px, 100%);
    min-height: 210px;
    margin: 0 auto;
    padding: 18px 0 8px;
    color: #173f4b;
}

:global(.stacked-number) {
    width: 150px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
    text-align: right;
}

:global(.stacked-number span) {
    color: #718078;
    font-size: 28px;
    font-weight: 800;
    text-align: center;
}

:global(.stacked-number strong) {
    font-size: 44px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: 1px;
}

:global(.stacked-line) {
    width: 150px;
    height: 3px;
    margin: 5px auto 8px;
    background: #718078;
    border-radius: 3px;
}

:global(.stacked-answer) {
    width: 150px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 28px 1fr;
    align-items: center;
}

:global(.stacked-answer > span) {
    color: #718078;
    font-size: 28px;
    font-weight: 800;
}

:global(.stacked-answer .typed-answer) {
    width: 86px;
    height: 58px;
    justify-self: end;
}

:global(.stacked-carry) {
    position: absolute;
    top: 1px;
    left: 50%;
    width: 150px;
    height: 35px;
    transform: translateX(-50%);
    pointer-events: none;
}

:global(.stacked-carry strong) {
    position: absolute;
    right: 18px;
    top: 0;
    color: #39704b;
    font-size: 19px;
    line-height: 1;
}

:global(.stacked-carry span) {
    display: none;
}

:global(.typed-answer-row) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 4px;
}

:global(.typed-answer) {
    width: 82px;
    height: 58px;
    border: 3px solid #9fc9ad;
    border-radius: 15px;
    background: #f7fbf8;
    color: #173f4b;
    font-family: inherit;
    font-size: 32px;
    font-weight: 800;
    text-align: center;
    outline: none;
    box-sizing: border-box;
}

:global(.typed-answer:focus) {
    border-color: #39704b;
    background: #ffffff;
}

:global(.check-writing) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 150px;
    margin-top: 10px;
    padding: 11px 18px;
    border: none;
    border-radius: 13px;
    background: #39704b;
    color: #ffffff;
    font-family: inherit;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
}

:global(.check-writing:hover) {
    opacity: 0.92;
}

:global(.check-writing:disabled) {
    opacity: 0.6;
    cursor: default;
}

:global(.typed-answer-hint) {
    margin-top: 9px;
    color: #718078;
    font-size: 10px;
}

:global(.word-problem-worksheet) {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
}

:global(.word-problem-story) {
    max-width: 620px;
    margin: 8px auto 20px;
    padding: 18px 22px;
    border-radius: 18px;
    background: #f4faf5;
    border: 1px solid #dcebe1;
    color: #31534a;
    font-size: 17px;
    line-height: 1.7;
}

:global(.word-problem-story p) {
    margin: 0;
}

:global(.word-problem-answer) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 4px;
}

:global(.word-problem-answer span) {
    color: #718078;
    font-size: 28px;
    font-weight: 800;
}

#mimi-image.correct {
    animation: mimiJump 0.55s ease;
}

#mimi-image.wrong {
    animation: mimiShake 0.45s ease;
}

@keyframes mimiJump {
    0% { transform: translateY(0); }
    40% { transform: translateY(-12px); }
    70% { transform: translateY(0); }
    100% { transform: translateY(-2px); }
}

@keyframes mimiShake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    50% { transform: translateX(6px); }
    75% { transform: translateX(-4px); }
}

.site-footer {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    background: #e8f6ec;
}

.site-footer .footer-inner {
    width: 100%;
    min-height: 64px;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
}

.site-footer .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
}

.site-footer .footer-brand img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

.site-footer .footer-brand > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.site-footer .footer-brand strong {
    font-size: 13px;
    line-height: 1.1;
}

.site-footer .footer-brand span {
    font-size: 10px;
    line-height: 1.2;
}

.site-footer .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
}

.site-footer .footer-links a {
    color: inherit;
    font-size: 11px;
    text-decoration: none;
}

.site-footer .footer-bottom {
    padding: 7px 24px 9px;
    font-size: 9px;
}

@media (max-width: 600px) {

    .game-page {
        padding: 0 12px 10px;
    }

    .exercise-info {
        display: block;
        width: 100%;
        margin-top: -7px;
        margin-bottom: 8px;
        text-align: left !important;
    }

    .exercise-info > div:first-child {
        display: block;
        width: 100%;
        text-align: left !important;
    }

    .exercise-info .lesson-badge {
        display: inline-flex;
        text-align: left !important;
    }

    .exercise-info h1 {
        width: 100%;
        margin: 5px 0 0;
        text-align: left !important;
        font-size: 22px;
    }

    .exercise-info p {
        width: 100%;
        margin: 5px 0 0;
        text-align: left !important;
        font-size: 10px;
    }

    .exercise-info .progress {
        width: 100%;
        margin-top: 3px;
        text-align: right !important;
        font-size: 9px;
    }

    .mode-selector {
        grid-template-columns: 1fr;
        gap: 5px;
    }

    .mode-button {
        padding: 8px 6px;
        border-radius: 10px;
        font-size: 10px;
    }

    #mimi-area {
        min-height: 44px;
    }

    #mimi-image {
        width: 44px;
        height: 44px;
    }

    .mimi-message {
        padding: 6px 9px;
        font-size: 10px;
    }

    .question-card {
        padding: 11px;
        border-radius: 17px;
    }

    :global(.stacked-addition-problem) {
        min-height: 175px;
        padding-top: 13px;
    }

    :global(.stacked-number) {
        width: 125px;
        grid-template-columns: 23px 1fr;
    }

    :global(.stacked-number span) {
        font-size: 22px;
    }

    :global(.stacked-number strong) {
        font-size: 34px;
    }

    :global(.stacked-line) {
        width: 125px;
        height: 2px;
        margin: 4px auto 7px;
    }

    :global(.stacked-answer) {
        width: 125px;
        grid-template-columns: 23px 1fr;
    }

    :global(.stacked-answer > span) {
        font-size: 22px;
    }

    :global(.stacked-answer .typed-answer) {
        width: 66px;
        height: 48px;
    }

    :global(.stacked-carry) {
        width: 125px;
    }

    :global(.stacked-carry strong) {
        right: 12px;
        font-size: 16px;
    }

    :global(.typed-answer-row) {
        gap: 7px;
    }

    :global(.typed-answer) {
        width: 58px;
        height: 48px;
        border-width: 2px;
        border-radius: 12px;
        font-size: 27px;
    }

    :global(.check-writing) {
        min-width: 130px;
        margin-top: 7px;
        padding: 9px 14px;
        font-size: 10px;
    }

    :global(.typed-answer-hint) {
        font-size: 9px;
    }

    :global(.word-problem-story) {
        margin: 5px auto 15px;
        padding: 13px 12px;
        font-size: 13px;
        line-height: 1.6;
    }

    :global(.word-problem-answer span) {
        font-size: 23px;
    }

    .site-footer .footer-inner {
        padding: 10px 12px;
    }

    .site-footer .footer-links {
        gap: 9px;
    }

    .site-footer .footer-links a {
        font-size: 9px;
    }

    .site-footer .footer-bottom {
        padding: 6px 12px 8px;
    }
}
</style>

<script>
const totalQuestions = 10;
const pointPerQuestion = 10;

let questionNumber = 0;
let score = 0;
let correctAnswer = 0;
let answering = false;

let stackedAdditionSkill = "no-carry";

const questionElement =
    document.getElementById("question");

const progressElement =
    document.getElementById("progress");

const mimiElement =
    document.getElementById("mimi-image");

const mimiMessage =
    document.getElementById("mimi-message");

const noCarryMode =
    document.getElementById("no-carry-mode");

const carryMode =
    document.getElementById("carry-mode");

const wordProblemMode =
    document.getElementById("word-problem-mode");

const modeButtons = [
    noCarryMode,
    carryMode,
    wordProblemMode
];

function setSkill(skill, button) {

    stackedAdditionSkill = skill;

    modeButtons.forEach((item) => {
        item.classList.remove("active");
    });

    button.classList.add("active");

    questionNumber = 0;
    score = 0;
    answering = false;

    generateQuestion();
}

noCarryMode.addEventListener(
    "click",
    () => setSkill("no-carry", noCarryMode)
);

carryMode.addEventListener(
    "click",
    () => setSkill("carry", carryMode)
);

wordProblemMode.addEventListener(
    "click",
    () => setSkill("word-problem", wordProblemMode)
);

function generateQuestion() {

    answering = false;

    questionNumber++;

    progressElement.textContent =
        `Soal ${questionNumber} dari ${totalQuestions}`;

    mimiMessage.textContent =
        "Yuk, hitung bersama Mimi! 😊";

    generateStackedAdditionQuestion();
}

function generateStackedAdditionQuestion() {

    if (stackedAdditionSkill === "no-carry") {

        const tens1 =
            Math.floor(Math.random() * 6) + 1;

        const ones1 =
            Math.floor(Math.random() * 5);

        const tens2 =
            Math.floor(Math.random() * 4) + 1;

        const ones2 =
            Math.floor(Math.random() * 5);

        const number1 =
            tens1 * 10 + ones1;

        const number2 =
            tens2 * 10 + ones2;

        correctAnswer =
            number1 + number2;

        createStackedAdditionWorksheet(
            number1,
            number2,
            correctAnswer
        );

    }

    else if (stackedAdditionSkill === "carry") {

        const tens1 =
            Math.floor(Math.random() * 4) + 1;

        const tens2 =
            Math.floor(Math.random() * 4) + 1;

        const ones1 =
            Math.floor(Math.random() * 5) + 5;

        const ones2 =
            Math.floor(Math.random() * 5) + 5;

        const number1 =
            tens1 * 10 + ones1;

        const number2 =
            tens2 * 10 + ones2;

        correctAnswer =
            number1 + number2;

        createStackedAdditionWorksheet(
            number1,
            number2,
            correctAnswer
        );

    }

    else if (stackedAdditionSkill === "word-problem") {

        const names = [
            "Athar",
            "Yafie",
            "Nadine",
            "Azzam",
            "Alden",
            "Jasmine",
            "Khalif",
            "Farel",
            "Bima",
            "Maryam",
            "Abynta",
            "Shabiyya",
            "Embun",
            "Aidan",
            "Bree",
            "Khailas",
            "Archie",
            "Aqila",
            "Ardhan",
            "Yusuf"
        ];

        const name =
            names[
                Math.floor(
                    Math.random() * names.length
                )
            ];

        const itemIcons = [
            "🍎",
            "🍬",
            "🎈",
            "🧸",
            "⭐",
            "🍪"
        ];

        const itemIcon =
            itemIcons[
                Math.floor(
                    Math.random() * itemIcons.length
                )
            ];

        const number1 =
            Math.floor(Math.random() * 39) + 10;

        const number2 =
            Math.floor(Math.random() * 30) + 10;

        correctAnswer =
            number1 + number2;

        createWordProblemWorksheet(
            name,
            number1,
            number2,
            correctAnswer,
            itemIcon
        );
    }
}

function createStackedAdditionWorksheet(
    number1,
    number2,
    answer
) {

    const onesSum =
        (number1 % 10) +
        (number2 % 10);

    const carry =
        Math.floor(onesSum / 10);

    const carryHTML =
        stackedAdditionSkill === "carry" && carry === 1
            ? `
                <div class="stacked-carry">
                    <span></span>
                    <strong>¹</strong>
                </div>
            `
            : "";

    questionElement.innerHTML = `

        <div class="stacked-addition-worksheet">

            <div class="stacked-addition-problem">

                ${carryHTML}

                <div class="stacked-number">
                    <span></span>
                    <strong>${number1}</strong>
                </div>

                <div class="stacked-number">
                    <span>+</span>
                    <strong>${number2}</strong>
                </div>

                <div class="stacked-line"></div>

                <div class="stacked-answer">
                    <span>=</span>

                    <input
                        id="typed-answer"
                        class="typed-answer"
                        type="text"
                        inputmode="numeric"
                        autocomplete="off"
                        maxlength="3"
                        placeholder="?"
                        aria-label="Ketik jawaban"
                    >
                </div>

            </div>

            <button
                id="check-writing"
                class="check-writing addition"
                type="button"
            >
                Cek Jawaban
                <span>▶</span>
            </button>

            <div class="typed-answer-hint">
                🔢 Hitung satuan dan puluhan, lalu ketik hasilnya
            </div>

        </div>
    `;

    setupTypedAnswer(answer);
}

function createWordProblemWorksheet(
    name,
    number1,
    number2,
    answer,
    itemIcon
) {

    questionElement.innerHTML = `

        <div class="word-problem-worksheet">

            <div class="word-problem-story">

                <p>
                    <strong>${name}</strong> memiliki
                    <strong>${number1}</strong> ${itemIcon}.
                    Kemudian <strong>${name}</strong> mendapat
                    <strong>${number2}</strong> ${itemIcon} lagi.
                    Berapa jumlah ${itemIcon}
                    <strong>${name}</strong> sekarang?
                </p>

            </div>

            <div class="word-problem-answer">

                <span>=</span>

                <input
                    id="typed-answer"
                    class="typed-answer"
                    type="text"
                    inputmode="numeric"
                    autocomplete="off"
                    maxlength="3"
                    placeholder="?"
                    aria-label="Ketik jawaban"
                >

            </div>

            <button
                id="check-writing"
                class="check-writing addition"
                type="button"
            >
                Cek Jawaban
                <span>▶</span>
            </button>

            <div class="typed-answer-hint">
                🔢 Baca ceritanya, hitung, lalu ketik jawabanmu
            </div>

        </div>
    `;

    setupTypedAnswer(answer);
}

function setupTypedAnswer(answer) {

    const input =
        document.getElementById("typed-answer");

    const checkButton =
        document.getElementById("check-writing");

    if (!input || !checkButton) {
        return;
    }

    input.addEventListener(
        "input",
        () => {
            input.value =
                input.value.replace(/[^0-9]/g, "");
        }
    );

    checkButton.addEventListener(
        "click",
        () => {
            checkTypedAnswer(answer);
        }
    );

    input.addEventListener(
        "keydown",
        (event) => {
            if (event.key === "Enter") {
                event.preventDefault();
                checkTypedAnswer(answer);
            }
        }
    );

    setTimeout(
        () => {
            input.focus();
        },
        100
    );
}

function checkTypedAnswer(answer) {

    if (answering) {
        return;
    }

    const input =
        document.getElementById("typed-answer");

    const checkButton =
        document.getElementById("check-writing");

    if (!input || !checkButton) {
        return;
    }

    const userValue =
        input.value.trim();

    if (!userValue) {

        mimiMessage.textContent =
            "Ketik jawabannya dulu ya 🔢";

        mimiElement.classList.remove(
            "correct",
            "wrong"
        );

        void mimiElement.offsetWidth;

        mimiElement.classList.add("wrong");

        input.focus();

        return;
    }

    if (Number(userValue) === Number(answer)) {

        checkTypedCorrect();

    } else {

        checkTypedWrong();

    }
}

function checkTypedCorrect() {

    if (answering) {
        return;
    }

    answering = true;

    score += pointPerQuestion;

    mimiMessage.textContent =
        "Hebat! Jawabanmu benar! 🎉";

    launchConfetti();

    mimiElement.classList.remove(
        "wrong",
        "correct"
    );

    void mimiElement.offsetWidth;

    mimiElement.classList.add("correct");

    const input =
        document.getElementById("typed-answer");

    const checkButton =
        document.getElementById("check-writing");

    if (input) {
        input.disabled = true;
    }

    if (checkButton) {
        checkButton.disabled = true;
        checkButton.innerHTML = "Benar! 🎉";
    }

    setTimeout(
        () => {

            if (questionNumber >= totalQuestions) {

                window.location.href =
                    `/hasil-latihan?kelas=2&latihan=06&skor=${score}`;

            } else {

                generateQuestion();

            }

        },
        900
    );
}

function checkTypedWrong() {

    mimiMessage.textContent =
        "Belum tepat. Coba lagi! 💪";

    mimiElement.classList.remove(
        "correct",
        "wrong"
    );

    void mimiElement.offsetWidth;

    mimiElement.classList.add("wrong");

    const input =
        document.getElementById("typed-answer");

    const checkButton =
        document.getElementById("check-writing");

    if (checkButton) {
        checkButton.disabled = false;
        checkButton.innerHTML =
            'Coba Lagi <span>↻</span>';
    }

    if (input) {
        input.focus();
        input.select();
    }
}

function launchConfetti() {

    const container =
        document.createElement("div");

    container.style.position = "fixed";
    container.style.left = "0";
    container.style.top = "0";
    container.style.width = "100vw";
    container.style.height = "100vh";
    container.style.pointerEvents = "none";
    container.style.overflow = "hidden";
    container.style.zIndex = "999999";

    document.body.appendChild(container);

    const colors = [
        "#7FAF8B",
        "#E8B86D",
        "#D98282",
        "#8FA8C7",
        "#C99A6B",
        "#F3C6C6",
        "#A8D8B9"
    ];

    for (let i = 0; i < 100; i++) {

        const piece =
            document.createElement("div");

        const size =
            8 + Math.random() * 7;

        piece.style.position = "absolute";
        piece.style.width = `${size}px`;
        piece.style.height = `${size * 1.5}px`;

        piece.style.backgroundColor =
            colors[
                Math.floor(
                    Math.random() * colors.length
                )
            ];

        piece.style.left =
            `${Math.random() * 100}vw`;

        piece.style.top = "-30px";
        piece.style.borderRadius = "3px";

        container.appendChild(piece);

        const x =
            (Math.random() - 0.5) * 300;

        const y =
            500 + Math.random() * 400;

        const rotation =
            360 + Math.random() * 720;

        piece.animate(
            [
                {
                    transform:
                        "translate3d(0, 0, 0) rotate(0deg)",
                    opacity: 1
                },
                {
                    transform:
                        `translate3d(${x}px, ${y}px, 0) rotate(${rotation}deg)`,
                    opacity: 0
                }
            ],
            {
                duration:
                    1800 + Math.random() * 1000,
                delay:
                    Math.random() * 200,
                easing:
                    "cubic-bezier(.2,.8,.3,1)",
                fill: "forwards"
            }
        );
    }

    setTimeout(
        () => {
            container.remove();
        },
        3500
    );
}

generateQuestion();
</script>
