---
import MainLayout from "../../../layouts/MainLayout.astro";
import Header from "../../../components/Header.astro";
---

<MainLayout title="Nilai Tempat - Mimi Matematika">
    <Header />

    <main class="game-page">

        <div class="game-topbar">
            <a href="/belajar/kelas-2" class="back-link">← Kembali</a>
            <span class="game-number">Kelas 2 SD</span>
            <div></div>
        </div>

        <section class="exercise-banner">
            <img src="/assets/banner-latihan.png" alt="Mimi Matematika" />
        </section>

        <section class="exercise-info">
            <div>
                <span class="lesson-badge">Latihan 03</span>
                <h1>Nilai Tempat</h1>
                <p>Kenali nilai tempat setiap angka.</p>
            </div>

            <div class="progress" id="progress">
                Soal 1 dari 10
            </div>
        </section>

        <section class="mode-selector">
            <button id="tens-ones-mode" class="mode-button active" type="button">
                🔢 Puluhan &amp; Satuan
            </button>

            <button id="hundreds-mode" class="mode-button" type="button">
                💯 Ratusan
            </button>
        </section>

        <section id="mimi-area">
            <img id="mimi-image" src="/assets/mimi.png" alt="Mimi" />

            <div class="mimi-message" id="mimi-message">
                Yuk, kenali nilai tempatnya! 😊
            </div>
        </section>

        <section class="question-card">

            <p class="question-instruction">
                Perhatikan bilangan berikut.
            </p>

            <div id="question"></div>

            <div class="answers" id="answers">
                <button type="button"></button>
                <button type="button"></button>
                <button type="button"></button>
                <button type="button"></button>
            </div>

        </section>

    </main>

    <footer class="site-footer">

        <div class="footer-inner">

            <div class="footer-brand">
                <img src="/assets/mimi.png" alt="Mimi Matematika" />

                <div>
                    <strong>Mimi Matematika</strong>
                    <span>
                        Langkah kecil hari ini, prestasi besar nanti.
                    </span>
                </div>
            </div>

            <div class="footer-links">
                <a href="/belajar">Belajar</a>
                <a href="/ngobrol">Mimi Ngobrol</a>
                <a href="/permainan">Permainan</a>
            </div>

        </div>

        <div class="footer-bottom">
            © 2026 Mimi Matematika
        </div>

    </footer>
</MainLayout>

<style>

.game-page {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px 12px;
}

.game-topbar {
    min-height: 42px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 0 2px;
}

.back-link {
    color: #39704b;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
}

.game-number {
    color: #718078;
    font-size: 12px;
    font-weight: 700;
}

.exercise-banner {
    width: 100%;
    overflow: hidden;
    margin: 0;
    line-height: 0;
}

.exercise-banner img {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
}

.exercise-info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-top: -12px;
    margin-bottom: 8px;
}

.exercise-info > div:first-child {
    text-align: left;
}

.lesson-badge {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border-radius: 999px;
    background: #e7f3ea;
    color: #39704b;
    font-size: 10px;
    font-weight: 800;
}

.exercise-info h1 {
    margin: 5px 0 0;
    color: #173f4b;
    font-size: 25px;
    line-height: 1.15;
}

.exercise-info p {
    margin: 5px 0 0;
    color: #718078;
    font-size: 11px;
}

.progress {
    color: #718078;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}

.mode-selector {
    display: flex;
    gap: 8px;
    margin: 8px 0 6px;
}

.mode-button {
    border: 2px solid #dce9df;
    border-radius: 12px;
    padding: 8px 13px;
    background: #ffffff;
    color: #718078;
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
}

.mode-button.active {
    background: #e8f5eb;
    border-color: #9fc9ad;
    color: #39704b;
}

#mimi-area {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    margin: 0 0 3px;
}

#mimi-image {
    width: 50px;
    height: 50px;
    object-fit: contain;
}

.mimi-message {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 7px 12px;
    border-radius: 14px;
    background: #eef8f0;
    color: #39704b;
    font-size: 11px;
    font-weight: 600;
}

.question-card {
    width: 100%;
    padding: 16px;
    border-radius: 22px;
    background: #ffffff;
    box-shadow: 0 5px 18px rgba(55, 80, 65, 0.07);
}

.question-instruction {
    margin: 0 0 12px;
    color: #718078;
    font-size: 11px;
    text-align: center;
}

/* ========================================
   BLOK NILAI TEMPAT
   ratusan = grid 10x10
   puluhan = batang 1x10
   satuan  = kotak tunggal
======================================== */

:global(.place-value-question) {
    text-align: center;
}

:global(.blocks-area) {
    min-height: 150px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 16px;
    padding: 12px;
}

/* baris puluhan + satuan */
:global(.small-blocks-row) {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 22px;
    min-height: 60px;
}

/* --- RATUSAN --- */

:global(.hundreds-area) {
    display: flex;
    flex-wrap: wrap;
    max-width: 440px;
    gap: 10px;
    justify-content: center;
}

:global(.hundreds-block) {
    display: grid;
    grid-template-columns: repeat(10, 11px);
    grid-template-rows: repeat(10, 11px);

    gap: 1px;
    padding: 1px;

    border: 1px solid #8aa893;
    border-radius: 3px;

    /* warna garis grid */
    background: #8aa893;

    box-sizing: content-box;
}

:global(.hundreds-block span) {
    display: block;
    background: #dfeadb;
}

/* --- PULUHAN --- */

:global(.tens-area) {
    display: flex;
    flex-wrap: wrap;
    max-width: 210px;
    gap: 6px;
    justify-content: center;
}

:global(.tens-block) {
    display: grid;
    grid-template-columns: repeat(1, 11px);
    grid-template-rows: repeat(10, 11px);

    gap: 1px;
    padding: 1px;

    border: 1px solid #8aa893;
    border-radius: 3px;

    background: #8aa893;

    box-sizing: content-box;
}

:global(.tens-block span) {
    display: block;
    background: #dfeadb;
}

/* --- SATUAN --- */

:global(.ones-area) {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    max-width: 130px;
    gap: 6px;
    justify-content: center;
}

:global(.ones-block) {
    display: block;

    width: 22px;
    height: 22px;

    border: 1px solid #8aa893;
    border-radius: 3px;

    background: #dfeadb;

    box-sizing: border-box;
}

/* --- TEKS --- */

:global(.place-number-preview) {
    margin-top: 8px;
    color: #718078;
    font-size: 14px;
}

:global(.place-number-preview strong) {
    color: #173f4b;
    font-size: 24px;
}

:global(.place-instruction) {
    margin-top: 8px;
    color: #39704b;
    font-size: 15px;
    font-weight: 700;
}

/* ========================================
   ANSWERS
======================================== */

.answers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    max-width: 760px;
    margin: 16px auto 0;
}

.answers button {
    min-height: 50px;
    padding: 9px 12px;

    border: 2px solid #dce9df;
    border-radius: 14px;

    background: #f9fcfa;
    color: #29372f;

    font-family: inherit;
    font-size: 12px;
    font-weight: 700;

    cursor: pointer;

    transition:
        transform 0.15s,
        background 0.15s;
}

.answers button:hover:not(:disabled) {
    transform: translateY(-1px);
    background: #eef8f0;
}

.answers button:focus-visible {
    outline: 3px solid #9fc9ad;
    outline-offset: 2px;
}

.answers button:disabled {
    cursor: default;
}

.answers button.is-correct {
    border-color: #9fc9ad;
    background: #e8f5eb;
    color: #39704b;
}

.answers button.is-wrong {
    border-color: #e6c3c3;
    background: #fdf1f1;
    color: #9a5b5b;
}

/* ========================================
   MIMI ANIMATION
======================================== */

#mimi-image.correct {
    animation: mimiJump 0.55s ease;
}

#mimi-image.wrong {
    animation: mimiShake 0.45s ease;
}

@keyframes mimiJump {
    0% {
        transform: translateY(0);
    }

    40% {
        transform: translateY(-12px);
    }

    70% {
        transform: translateY(0);
    }

    100% {
        transform: translateY(-2px);
    }
}

@keyframes mimiShake {
    0%,
    100% {
        transform: translateX(0);
    }

    25% {
        transform: translateX(-6px);
    }

    50% {
        transform: translateX(6px);
    }

    75% {
        transform: translateX(-4px);
    }
}

@media (prefers-reduced-motion: reduce) {

    #mimi-image.correct,
    #mimi-image.wrong {
        animation: none;
    }

    
}

/* ========================================
   FOOTER
======================================== */

.site-footer {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    background: #e8f6ec;
}

.site-footer .footer-inner {
    width: 100%;
    min-height: 64px;
    padding: 12px 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.site-footer .footer-brand {
    display: flex;
    align-items: center;
    gap: 8px;
}

.site-footer .footer-brand img {
    width: 32px;
    height: 32px;
    object-fit: contain;
}

.site-footer .footer-brand > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.site-footer .footer-brand strong {
    font-size: 13px;
    line-height: 1.1;
}

.site-footer .footer-brand span {
    font-size: 10px;
    line-height: 1.2;
}

.site-footer .footer-links {
    display: flex;
    align-items: center;
    gap: 18px;
}

.site-footer .footer-links a {
    color: inherit;
    font-size: 11px;
    text-decoration: none;
}

.site-footer .footer-bottom {
    padding: 7px 24px 9px;
    font-size: 9px;
}

/* ========================================
   MOBILE
======================================== */

@media (max-width: 600px) {

    .game-page {
        padding: 0 12px 10px;
    }

 .exercise-info {
    display: block;
    width: 100%;
    margin-top: -7px;
    margin-bottom: 8px;
}

.exercise-info > div:first-child {
    width: 100%;
    display: block;
    text-align: left !important;
}

.exercise-info .lesson-badge,
.exercise-info h1,
.exercise-info p {
    text-align: left !important;
}

.exercise-info .progress {
    width: 100%;
    margin-top: 3px;
    text-align: right !important;
}

    .exercise-info h1 {
        font-size: 22px;
    }

    .exercise-info p {
        font-size: 10px;
    }

    .progress {
        font-size: 9px;
    }

    .mode-selector {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
    }

    .mode-button {
        padding: 8px 4px;
        border-radius: 10px;
        font-size: 9px;
    }

    #mimi-area {
        min-height: 44px;
    }

    #mimi-image {
        width: 44px;
        height: 44px;
    }

    .mimi-message {
        padding: 6px 9px;
        font-size: 10px;
    }

    .question-card {
        padding: 11px;
        border-radius: 17px;
    }

    :global(.blocks-area) {
        min-height: 130px;
        gap: 12px;
        padding: 5px;
    }

    :global(.small-blocks-row) {
        gap: 14px;
        min-height: 46px;
    }

    :global(.hundreds-area) {
        max-width: 290px;
        gap: 7px;
    }

    :global(.hundreds-block) {
        grid-template-columns: repeat(10, 8px);
        grid-template-rows: repeat(10, 8px);
    }

    :global(.tens-area) {
        max-width: 155px;
        gap: 5px;
    }

    :global(.tens-block) {
        grid-template-columns: repeat(1, 8px);
        grid-template-rows: repeat(10, 8px);
    }

    :global(.ones-area) {
        max-width: 100px;
        gap: 5px;
    }

    :global(.ones-block) {
        width: 17px;
        height: 17px;
    }

    :global(.place-number-preview) {
        font-size: 12px;
    }

    :global(.place-number-preview strong) {
        font-size: 20px;
    }

    :global(.place-instruction) {
        font-size: 13px;
    }

    .answers {
        gap: 7px;
        margin-top: 11px;
    }

    .answers button {
        min-height: 46px;
        padding: 7px 6px;
        border-radius: 12px;
        font-size: 10px;
    }

    .site-footer .footer-inner {
        padding: 10px 12px;
    }

    .site-footer .footer-links {
        gap: 9px;
    }

    .site-footer .footer-links a {
        font-size: 9px;
    }

    .site-footer .footer-bottom {
        padding: 6px 12px 8px;
    }
    .answers button {
        transition: none;
    }
       .exercise-info > div:first-child {
        text-align: left;
    }
}

</style>

<script>

const totalQuestions = 10;
const pointPerQuestion = 10;

let questionNumber = 0;
let score = 0;

let skill = "tensOnes";

let correctAnswer = {};

let answering = false;


/* ========================================
   ELEMENTS
======================================== */

const questionElement = document.getElementById("question");
const answersContainer = document.getElementById("answers");
const answerButtons = answersContainer.querySelectorAll("button");
const progressElement = document.getElementById("progress");
const mimiElement = document.getElementById("mimi-image");
const mimiMessage = document.getElementById("mimi-message");
const tensOnesMode = document.getElementById("tens-ones-mode");
const hundredsMode = document.getElementById("hundreds-mode");


/* ========================================
   HELPERS
======================================== */

function randomInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

function shuffle(list) {

    const items = [...list];

    for (let i = items.length - 1; i > 0; i--) {

        const j = Math.floor(Math.random() * (i + 1));

        [items[i], items[j]] = [items[j], items[i]];
    }

    return items;
}

function answerKey(answer) {

    return skill === "tensOnes"
        ? `${answer.tens}-${answer.ones}`
        : `${answer.hundreds}-${answer.tens}-${answer.ones}`;
}

function answerLabel(answer) {

    return skill === "tensOnes"
        ? `${answer.tens} puluhan + ${answer.ones} satuan`
        : `${answer.hundreds} ratusan + ${answer.tens} puluhan + ${answer.ones} satuan`;
}

function buildBlocks(count, className, cellCount) {

    let html = "";

    for (let i = 0; i < count; i++) {

        const cells = cellCount
            ? Array.from({ length: cellCount }, () => "<span></span>").join("")
            : "";

        html += cellCount
            ? `<div class="${className}">${cells}</div>`
            : `<span class="${className}"></span>`;
    }

    return html;
}

function setMimi(message, state) {

    mimiMessage.textContent = message;

    mimiElement.classList.remove("correct", "wrong");

    if (state) {
        void mimiElement.offsetWidth;
        mimiElement.classList.add(state);
    }
}


/* ========================================
   MODE
======================================== */

function switchMode(nextSkill) {

    if (skill === nextSkill && questionNumber <= 1) {
        return;
    }

    skill = nextSkill;

    tensOnesMode.classList.toggle("active", nextSkill === "tensOnes");
    hundredsMode.classList.toggle("active", nextSkill === "hundreds");

    questionNumber = 0;
    score = 0;

    setMimi("Yuk, kenali nilai tempatnya! 😊", null);

    generateQuestion();
}

tensOnesMode.addEventListener("click", () => switchMode("tensOnes"));
hundredsMode.addEventListener("click", () => switchMode("hundreds"));


/* ========================================
   GENERATE
======================================== */

function generateQuestion() {

    answering = false;

    questionNumber++;

    progressElement.textContent =
        `Soal ${questionNumber} dari ${totalQuestions}`;

    if (skill === "tensOnes") {
        generateTensOnesQuestion();
    } else {
        generateHundredsQuestion();
    }
}


/* --- 03A: puluhan & satuan --- */

function generateTensOnesQuestion() {

    const tens = randomInt(1, 9);
    const ones = randomInt(0, 9);

    const number = tens * 10 + ones;

    correctAnswer = { tens, ones };

    questionElement.innerHTML = `

        <div class="place-value-question">

            <div class="blocks-area">

                <div class="small-blocks-row">

                    <div class="tens-area">
                        ${buildBlocks(tens, "tens-block", 10)}
                    </div>

                    <div class="ones-area">
                        ${buildBlocks(ones, "ones-block")}
                    </div>

                </div>

            </div>

            <div class="place-number-preview">
                Bilangan: <strong>${number}</strong>
            </div>

            <div class="place-instruction">
                Berapa <strong>puluhan</strong> dan <strong>satuan</strong>?
            </div>

        </div>
    `;

    createAnswers();
}


/* --- 03B: ratusan --- */

function generateHundredsQuestion() {

    const hundreds = randomInt(1, 9);
    const tens = randomInt(0, 9);
    const ones = randomInt(0, 9);

    const number = hundreds * 100 + tens * 10 + ones;

    correctAnswer = { hundreds, tens, ones };

    questionElement.innerHTML = `

        <div class="place-value-question">

            <div class="blocks-area">

                <div class="hundreds-area">
                    ${buildBlocks(hundreds, "hundreds-block", 100)}
                </div>

                <div class="small-blocks-row">

                    <div class="tens-area">
                        ${buildBlocks(tens, "tens-block", 10)}
                    </div>

                    <div class="ones-area">
                        ${buildBlocks(ones, "ones-block")}
                    </div>

                </div>

            </div>

            <div class="place-number-preview">
                Bilangan: <strong>${number}</strong>
            </div>

            <div class="place-instruction">
                Berapa <strong>ratusan</strong>, <strong>puluhan</strong>
                dan <strong>satuan</strong>?
            </div>

        </div>
    `;

    createAnswers();
}


/* ========================================
   ANSWERS
======================================== */

function buildCandidates() {

    if (skill === "tensOnes") {

        const { tens, ones } = correctAnswer;

        return [
            { tens: (tens % 9) + 1, ones },
            { tens, ones: (ones + 1) % 10 },
            { tens: ones === 0 ? tens + 1 : ones, ones: tens },
            { tens: tens === 1 ? tens + 2 : tens - 1, ones },
            { tens, ones: (ones + 5) % 10 },
            { tens: (tens + 3) % 9 + 1, ones: (ones + 2) % 10 }
        ];
    }

    const { hundreds, tens, ones } = correctAnswer;

    return [
        { hundreds: (hundreds % 9) + 1, tens, ones },
        { hundreds, tens: (tens + 1) % 10, ones },
        { hundreds, tens, ones: (ones + 1) % 10 },
        { hundreds, tens: ones, ones: tens },
        { hundreds: hundreds === 1 ? 3 : hundreds - 1, tens, ones },
        { hundreds, tens: (tens + 4) % 10, ones: (ones + 3) % 10 }
    ];
}

function createAnswers() {

    const used = new Set([answerKey(correctAnswer)]);
    const answers = [correctAnswer];

    for (const candidate of buildCandidates()) {

        if (answers.length === answerButtons.length) {
            break;
        }

        const key = answerKey(candidate);

        if (!used.has(key)) {
            used.add(key);
            answers.push(candidate);
        }
    }

    const shuffled = shuffle(answers);

    answerButtons.forEach((button, index) => {

        const answer = shuffled[index];

        button.disabled = false;
        button.classList.remove("is-correct", "is-wrong");
        button.textContent = answerLabel(answer);

        button.onclick = () => checkAnswer(answer, button);
    });
}


/* ========================================
   CHECK
======================================== */

function isAnswerCorrect(answer) {

    if (skill === "tensOnes") {

        return answer.tens === correctAnswer.tens
            && answer.ones === correctAnswer.ones;
    }

    return answer.hundreds === correctAnswer.hundreds
        && answer.tens === correctAnswer.tens
        && answer.ones === correctAnswer.ones;
}

function finishExercise() {

    window.location.href =
        `/hasil-latihan?kelas=2&latihan=03&skor=${score}`;
}

function checkAnswer(answer, button) {

    if (answering) {
        return;
    }

    if (!isAnswerCorrect(answer)) {

        button.classList.add("is-wrong");
        button.disabled = true;

        setMimi("Belum tepat. Coba lagi! 💪", "wrong");

        return;
    }

    answering = true;

    score += pointPerQuestion;

    button.classList.add("is-correct");

    answerButtons.forEach(item => {
        item.disabled = true;
    });

    const isLast = questionNumber >= totalQuestions;

    setMimi(
        isLast
            ? "Selesai! Kerja bagus! 🎉"
            : "Hebat! Jawabanmu benar! 🎉",
        "correct"
    );

    setTimeout(
        () => {

            if (isLast) {
                finishExercise();
            } else {
                generateQuestion();
            }
        },
        800
    );
}


/* ========================================
   START
======================================== */

generateQuestion();

</script>